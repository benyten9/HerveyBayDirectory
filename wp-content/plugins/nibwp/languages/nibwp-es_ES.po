msgstr "Imagen"

#: assets/js/studio-builder-sketch.js:82
msgid "e.g. The Colosseum at sunset, from the media library"
msgstr "p. ej. El Coliseo al atardecer, de la biblioteca de medios"

#: assets/js/studio-builder-sketch.js:83
#: assets/js/studio-builder.js:204
#: assets/js/studio-builder.js:2749
#: assets/js/studio-builder.js:2960
#: assets/js/studio-builder.js:5974
