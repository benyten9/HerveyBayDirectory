msgstr "Weglot — Sincronizar con el espacio de trabajo"

#: includes/premium/integrations/weglot.php:1201
msgid "No Weglot API key is configured, so there is no workspace to sync with."
msgstr "No hay ninguna clave API de Weglot configurada, así que no hay espacio de trabajo con el que sincronizar."

