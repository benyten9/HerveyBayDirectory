#: includes/premium/integrations/eventprime.php:1727
msgid "A name is required."
msgstr "Se necesita un nombre."

#: includes/premium/integrations/eventprime.php:1571
msgid "WordPress refused to create the term."
msgstr "WordPress se ha negado a crear el término."

#: includes/premium/integrations/eventprime.php:1588
msgid "Updating a venue"
msgstr "Actualizar un lugar"

#: includes/premium/integrations/eventprime.php:1601
