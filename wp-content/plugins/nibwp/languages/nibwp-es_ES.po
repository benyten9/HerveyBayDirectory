msgstr "aún nada: ingiere uno primero."

#: includes/integrations/paper/paper.php:1241
#: includes/integrations/paper/paper.php:1362
msgid "That design has no stored structure. Ingest it again."
msgstr "Ese diseño no tiene ninguna estructura guardada. Vuelve a ingerirlo."

