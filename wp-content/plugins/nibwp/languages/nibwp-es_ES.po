msgstr "Botón"

#: assets/js/studio-builder-sketch.js:83
msgid "e.g. Book now, links to the booking page"
msgstr "p. ej. Reserva ahora, enlaza a la página de reservas"

#: assets/js/studio-builder-sketch.js:84
#: assets/js/studio-builder.js:214
msgid "Card"
msgstr "Tarjeta"

#: assets/js/studio-builder-sketch.js:84
msgid "e.g. Photo, tour name, price and a button"
msgstr "p. ej. Foto, nombre del tour, precio y un botón"

#: assets/js/studio-builder-sketch.js:85
#: assets/js/studio-builder.js:218
#: assets/js/studio-builder.js:2749
#: assets/js/studio-builder.js:2960
msgid "Form"
msgstr "Formulario"

#: assets/js/studio-builder-sketch.js:85
msgid "e.g. Name, email, date, message"
msgstr "p. ej. Nombre, correo, fecha, mensaje"

#: assets/js/studio-builder-sketch.js:86
#: assets/js/studio-builder.js:217
#: assets/js/studio-builder.js:2749
#: assets/js/studio-builder.js:5964
msgid "Menu"
msgstr "Menú"

#: assets/js/studio-builder-sketch.js:86
msgid "e.g. The main menu"
msgstr "p. ej. El menú principal"

#: assets/js/studio-builder-sketch.js:87
#: assets/js/studio-builder.js:207
#: assets/js/studio-builder.js:2749
msgid "List"
msgstr "Lista"

#: assets/js/studio-builder-sketch.js:87
msgid "e.g. Six questions as an accordion"
