msgstr "Seguridad, protección del contenido y configuración de la auditoría."

#: includes/helpers.php:2609
msgid "Set rate limits"
msgstr "Fija límites de peticiones"

#: includes/helpers.php:2609
msgid "Prevents runaway AI agents. 30-60 calls/min recommended."
msgstr "Evita agentes de IA descontrolados. Se recomiendan 30-60 llamadas/min."

#: includes/helpers.php:2610
msgid "Enable Force Draft"
msgstr "Activa Forzar borrador"

#: includes/helpers.php:2610
msgid "All AI-created posts become drafts for review."
msgstr "Todas las entradas creadas por IA pasan a ser borradores para revisarlas."

#: includes/helpers.php:2611
msgid "Configure audit retention"
msgstr "Configura la conservación de la auditoría"

#: includes/helpers.php:2611
