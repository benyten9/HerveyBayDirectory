msgstr "redirect_to debe ser same, custom_page o external_url. Son las tres que ofrece el constructor (includes/admin/builder/class-evf-builder-settings.php:666-667)."

#: includes/premium/integrations/everest-forms.php:2036
msgid "custom_page needs page_id to be a post or page that exists on this site."
msgstr "custom_page necesita que page_id sea una entrada o página que exista en este sitio."

