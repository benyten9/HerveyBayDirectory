msgstr "Programm"

#: includes/premium/integrations/eventin.php:272
msgid "attendee"
msgstr "Teilnehmer"

#: includes/premium/integrations/eventin.php:274
msgid "speaker"
msgstr "Speaker"

#: includes/premium/integrations/eventin.php:276
#: includes/premium/integrations/events.php:172
msgid "organizer"
msgstr "Veranstalter"

#: includes/premium/integrations/eventin.php:279
#: includes/premium/integrations/events.php:175
msgid "event"
msgstr "Event"

#. translators: %s: the kind of record, e.g. event
#. translators: %s: the kind of record, e.g. speaker
#. translators: %s: the kind of record, e.g. venue
#: includes/premium/integrations/eventin.php:301
#: includes/premium/integrations/eventin.php:362
#: includes/premium/integrations/eventprime.php:215
#: includes/premium/integrations/eventprime.php:286
#: includes/premium/integrations/events.php:196
#, php-format
msgid "A positive %s id is required."
msgstr "Eine positive %s-ID ist erforderlich."

#. translators: %d: post ID
#: includes/premium/integrations/eventin.php:314
#: includes/premium/integrations/eventprime.php:228
#: includes/premium/integrations/events.php:209
#, php-format
msgid "Nothing with the id %d exists on this site."
msgstr "Auf dieser Website existiert nichts mit der ID %d."

#. translators: 1: post ID, 2: actual post type, 3: expected post type
#: includes/premium/integrations/eventin.php:335
#: includes/premium/integrations/eventprime.php:244
#: includes/premium/integrations/events.php:225
#, php-format
msgid "Post %1$d is a \"%2$s\", not a \"%3$s\". Refusing on the type before considering permissions."
msgstr "Beitrag %1$d ist ein \"%2$s\", kein \"%3$s\". Abgelehnt aufgrund des Typs, noch vor der Berechtigungsprüfung."

#. translators: %d: user ID
#: includes/premium/integrations/eventin.php:375
#, php-format
msgid "No user with the id %d exists on this site."
msgstr "Auf dieser Website existiert kein Benutzer mit der ID %d."

#. translators: 1: user ID, 2: expected role name
#: includes/premium/integrations/eventin.php:389
#, php-format
msgid "User %1$d does not hold the \"%2$s\" role. Refusing on the role before considering permissions."
msgstr "Benutzer %1$d hat nicht die Rolle \"%2$s\". Abgelehnt aufgrund der Rolle, noch vor der Berechtigungsprüfung."

#. translators: 1: input field name, 2: list of accepted formats
#: includes/premium/integrations/eventin.php:461
#: includes/premium/integrations/events.php:319
#, php-format
msgid "%1$s must be a date string. Accepted formats: %2$s."
msgstr "%1$s muss ein Datums-String sein. Akzeptierte Formate: %2$s."

#. translators: %s: input field name
#: includes/premium/integrations/eventin.php:475
#, php-format
msgid "%s is empty."
msgstr "%s ist leer."

#. translators: 1: input field name, 2: the value received, 3: list of accepted formats
#: includes/premium/integrations/eventin.php:497
#, php-format
msgid "%1$s is not a date this integration will guess at: \"%2$s\". Accepted formats: %3$s. A date written any other way stores as a value MySQL cannot cast, and the event then never appears on the calendar."
msgstr "%1$s ist kein Datum, das diese Integration errät: \"%2$s\". Akzeptierte Formate: %3$s. Ein anders geschriebenes Datum wird als Wert gespeichert, den MySQL nicht umwandeln kann, und das Event erscheint dann nie im Kalender."

#. translators: %s: the timezone value received
#: includes/premium/integrations/eventin.php:550
#, php-format
msgid "\"%s\" is not a timezone PHP recognises. Use an Olson name such as Europe/Rome, or a UTC offset such as +02:00."
msgstr "\"%s\" ist keine Zeitzone, die PHP kennt. Verwende einen Olson-Namen wie Europe/Rome oder einen UTC-Versatz wie +02:00."

#: includes/premium/integrations/eventin.php:558
msgid "No usable timezone could be resolved."
msgstr "Es konnte keine brauchbare Zeitzone ermittelt werden."

#: includes/premium/integrations/eventin.php:630
msgid "start_date is required: Eventin cannot place an event without one."
msgstr "start_date ist erforderlich: Eventin kann ein Event ohne Startdatum nicht einordnen."

#. translators: 1: end date and time, 2: start date and time
#: includes/premium/integrations/eventin.php:664
#, php-format
msgid "The end (%1$s) is before the start (%2$s). Refusing rather than silently swapping them."
msgstr "Das Ende (%1$s) liegt vor dem Beginn (%2$s). Abgelehnt, statt die beiden still zu vertauschen."

#. translators: %d: number of records omitted
#: includes/premium/integrations/eventin.php:1006
#: includes/premium/integrations/events.php:1001
#, php-format
msgid "%d record was left out because this account cannot edit it, so this list is not complete."
msgid_plural "%d records were left out because this account cannot edit them, so this list is not complete."
msgstr[0] "%d Datensatz wurde ausgelassen, weil dieses Konto ihn nicht bearbeiten kann, diese Liste ist also nicht vollständig."
msgstr[1] "%d Datensätze wurden ausgelassen, weil dieses Konto sie nicht bearbeiten kann, diese Liste ist also nicht vollständig."

#. translators: 1: to_date, 2: from_date
#: includes/premium/integrations/eventin.php:1256
#, php-format
msgid "to_date (%1$s) is before from_date (%2$s)."
msgstr "to_date (%1$s) liegt vor from_date (%2$s)."

#: includes/premium/integrations/eventin.php:1309
#: includes/premium/integrations/eventprime.php:976
#: includes/premium/integrations/events-manager.php:1237
#: includes/premium/integrations/events.php:1391
msgid "Listing events"
msgstr "Events auflisten"

#: includes/premium/integrations/eventin.php:1371
msgid "Listing upcoming events"
msgstr "Anstehende Events auflisten"

#: includes/premium/integrations/eventin.php:1432
msgid "Reading an event"
msgstr "Ein Event lesen"

#: includes/premium/integrations/eventin.php:1527
#: includes/premium/integrations/eventin.php:1534
msgid "event_data.title is required to create an event."
msgstr "event_data.title ist zum Erstellen eines Events erforderlich."

#. translators: 1: the status requested, 2: comma separated list of valid statuses
#: includes/premium/integrations/eventin.php:1553
#: includes/premium/integrations/eventin.php:1746
#, php-format
msgid "\"%1$s\" is not a status this integration will set. Allowed: %2$s."
msgstr "\"%1$s\" ist kein Status, den diese Integration setzt. Erlaubt: %2$s."

#: includes/premium/integrations/eventin.php:1574
#: includes/premium/integrations/events-manager.php:1505
msgid "event_data.start_date is required to create an event."
msgstr "event_data.start_date ist zum Erstellen eines Events erforderlich."

#: includes/premium/integrations/eventin.php:1607
#: includes/premium/integrations/eventprime.php:1091
#: includes/premium/integrations/events-manager.php:1661
#: includes/premium/integrations/events.php:1472
msgid "Creating an event"
msgstr "Ein Event erstellen"

#: includes/premium/integrations/eventin.php:1616
msgid "event_data is required, with at least a title and a start_date."
msgstr "event_data ist erforderlich, mit mindestens title und start_date."

#: includes/premium/integrations/eventin.php:1638
msgid "WordPress returned no id for the new event."
msgstr "WordPress hat für das neue Event keine ID zurückgegeben."

#. translators: 1: post ID, 2: post status
#: includes/premium/integrations/eventin.php:1646
#, php-format
msgid "Event %1$d created with status \"%2$s\"."
msgstr "Event %1$d mit Status \"%2$s\" erstellt."

#: includes/premium/integrations/eventin.php:1663
msgid "Updating an event"
msgstr "Ein Event aktualisieren"

#: includes/premium/integrations/eventin.php:1672
msgid "event_data is required and must name at least one field to change."
msgstr "event_data ist erforderlich und muss mindestens ein zu änderndes Feld nennen."

#. translators: %d: post ID
#: includes/premium/integrations/eventin.php:1700
#, php-format
msgid "Event %d updated."
msgstr "Event %d aktualisiert."

#: includes/premium/integrations/eventin.php:1733
msgid "Changing an event status"
msgstr "Den Status eines Events ändern"

#. translators: 1: post ID, 2: comma separated list of meta keys
#: includes/premium/integrations/eventin.php:1761
#, php-format
msgid "Event %1$d cannot be published: it is missing %2$s. Published without them it would exist and never appear on the calendar. Set them with update_event first."
msgstr "Event %1$d kann nicht veröffentlicht werden: Es fehlt %2$s. Ohne diese veröffentlicht, würde es existieren und nie im Kalender erscheinen. Setze sie zuerst mit update_event."

#. translators: 1: post ID, 2: post status
#: includes/premium/integrations/eventin.php:1781
#, php-format
msgid "Event %1$d is now \"%2$s\"."
msgstr "Event %1$d ist jetzt \"%2$s\"."

#: includes/premium/integrations/eventin.php:1799
msgid "Trashing an event"
msgstr "Ein Event in den Papierkorb verschieben"

#: includes/premium/integrations/eventin.php:1808
msgid "WordPress refused to trash the event."
msgstr "WordPress hat das Verschieben des Events in den Papierkorb verweigert."

#. translators: %d: post ID
#: includes/premium/integrations/eventin.php:1815
#, php-format
msgid "Event %d moved to trash. Restore it from wp-admin if this was wrong."
msgstr "Event %d in den Papierkorb verschoben. Stell es im wp-admin wieder her, falls das falsch war."

#: includes/premium/integrations/eventin.php:1842
msgid "Permanently deleting an event"
msgstr "Ein Event endgültig löschen"

#. translators: %d: post ID
#: includes/premium/integrations/eventin.php:1853
#, php-format
msgid "Permanently deleting event %d is irreversible and leaves its attendee records pointing at an event that no longer exists. Send confirm: true once the owner has agreed."
msgstr "Das endgültige Löschen von Event %d ist unumkehrbar und lässt seine Teilnehmerdatensätze auf ein Event verweisen, das nicht mehr existiert. Sende confirm: true, sobald der Betreiber zugestimmt hat."

#: includes/premium/integrations/eventin.php:1866
msgid "WordPress refused to delete the event."
msgstr "WordPress hat das Löschen des Events verweigert."

#. translators: 1: post ID, 2: number of attendee records left behind
#: includes/premium/integrations/eventin.php:1876
#, php-format
msgid "Event %1$d deleted permanently. %2$d attendee records still name it and are now orphans; delete them from the Attendees screen if that is what the owner wants."
msgstr "Event %1$d endgültig gelöscht. %2$d Teilnehmerdatensätze nennen es noch und sind jetzt verwaist; lösche sie auf dem Bildschirm „Teilnehmer“, wenn der Betreiber das will."

#: includes/premium/integrations/eventin.php:1901
msgid "Listing organisers"
msgstr "Veranstalter auflisten"

#: includes/premium/integrations/eventin.php:1901
msgid "Listing speakers"
msgstr "Speaker auflisten"

#: includes/premium/integrations/eventin.php:1957
msgid "Reading an organiser"
msgstr "Einen Veranstalter lesen"

#: includes/premium/integrations/eventin.php:1957
msgid "Reading a speaker"
msgstr "Einen Speaker lesen"

#: includes/premium/integrations/eventin.php:1984
msgid "Listing a person's events"
msgstr "Die Events einer Person auflisten"

#: includes/premium/integrations/eventin.php:2127
msgid "Listing schedules"
msgstr "Programme auflisten"

#: includes/premium/integrations/eventin.php:2177
msgid "Reading a schedule"
msgstr "Ein Programm lesen"

#: includes/premium/integrations/eventin.php:2213
msgid "Reading an event agenda"
msgstr "Das Programm eines Events lesen"

#: includes/premium/integrations/eventin.php:2285
msgid "Reading ticket types"
msgstr "Tickettypen lesen"

#: includes/premium/integrations/eventin.php:2319
msgid "Reading ticket availability"
msgstr "Ticketverfügbarkeit lesen"

#: includes/premium/integrations/eventin.php:2422
msgid "Listing attendees"
msgstr "Teilnehmer auflisten"

#: includes/premium/integrations/eventin.php:2498
msgid "Reading an attendee"
msgstr "Einen Teilnehmer lesen"

#: includes/premium/integrations/eventin.php:2529
msgid "Counting attendees"
msgstr "Teilnehmer zählen"

#: includes/premium/integrations/eventin.php:2616
msgid "Reading check-in status"
msgstr "Check-in-Status lesen"

#: includes/premium/integrations/eventin.php:2709
msgid "Reading event revenue"
msgstr "Event-Umsatz lesen"

#: includes/premium/integrations/eventin.php:2716
#: includes/premium/integrations/events-manager.php:520
msgid "A positive event_id is required."
msgstr "Eine positive event_id ist erforderlich."

#: includes/premium/integrations/eventin.php:2773
msgid "Grouped by the order status Eventin stored, not by a hardcoded list of paid statuses: a total that silently dropped a status we had not seen would understate the event. Gateway transaction ids and customer details are never read by this action."
msgstr "Gruppiert nach dem Bestellstatus, den Eventin gespeichert hat, nicht nach einer fest eingetragenen Liste bezahlter Status: Eine Summe, die einen unbekannten Status still weglässt, würde das Event zu niedrig ausweisen. Transaktions-IDs des Zahlungsanbieters und Kundendaten liest diese Aktion nie."

#: includes/premium/integrations/eventin.php:2788
msgid "Reading Eventin settings"
msgstr "Eventin-Einstellungen lesen"

#: includes/premium/integrations/eventin.php:2834
msgid "Settings leave here through an allow-list. Payment, mail, map and meeting credentials are reported as a name and whether they are set, and their values never travel."
msgstr "Einstellungen verlassen das System nur über eine Erlaubnisliste. Zugangsdaten für Zahlung, E-Mail, Karten und Meetings werden nur mit Namen und der Angabe gemeldet, ob sie gesetzt sind, und ihre Werte gehen nie hinaus."

#: includes/premium/integrations/eventin.php:2900
#: includes/premium/integrations/events.php:2378
msgid "Auditing the calendar"
msgstr "Den Kalender prüfen"

#: includes/premium/integrations/eventin.php:2936
msgid "Published events with no start date. Eventin has nothing to compare, so they never appear on the calendar or in the archive."
msgstr "Veröffentlichte Events ohne Startdatum. Eventin hat nichts zum Vergleichen, daher erscheinen sie nie im Kalender oder im Archiv."

#: includes/premium/integrations/eventin.php:2960
msgid "Events whose start date is not Y-m-d. MySQL casts these to NULL, so they drop out of every calendar range query: the event exists and is invisible."
msgstr "Events, deren Startdatum nicht Y-m-d ist. MySQL wandelt diese in NULL um, daher fallen sie aus jeder Kalender-Bereichsabfrage: Das Event existiert und ist unsichtbar."

#: includes/premium/integrations/eventin.php:2986
msgid "Events whose end is before their start. These sort and display wrongly everywhere, and report as expired the moment they are created."
msgstr "Events, deren Ende vor dem Beginn liegt. Diese werden überall falsch sortiert und angezeigt und gelten ab dem Moment ihrer Erstellung als abgelaufen."

#: includes/premium/integrations/eventin.php:3010
msgid "Published events with no ticket types. Visitors reach a registration form with nothing to choose."
msgstr "Veröffentlichte Events ohne Tickettypen. Besucher landen auf einem Anmeldeformular ohne Auswahl."

#: includes/premium/integrations/eventin.php:3039
msgid "Sold-out events still published and still in the future. The listing invites bookings the stock check will refuse at the last step."
msgstr "Ausverkaufte Events, die noch veröffentlicht sind und in der Zukunft liegen. Die Liste lädt zu Buchungen ein, die die Bestandsprüfung im letzten Schritt ablehnt."

#: includes/premium/integrations/eventin.php:3064
msgid "Past events still featured on the front of the site."
msgstr "Vergangene Events, die noch auf der Startseite hervorgehoben sind."

#: includes/premium/integrations/eventin.php:3093
msgid "Attendee records with no ticket. Not checked: this account does not hold etn_manage_attendee, and zero would read as all-clear."
msgstr "Teilnehmerdatensätze ohne Ticket. Nicht geprüft: Dieses Konto hat etn_manage_attendee nicht, und null würde wie Entwarnung aussehen."

#: includes/premium/integrations/eventin.php:3143
msgid "Attendee records with neither a ticket type nor a ticket id. They cannot be checked in and will not appear on a ticket."
msgstr "Teilnehmerdatensätze ohne Tickettyp und ohne Ticket-ID. Sie können nicht eingecheckt werden und erscheinen auf keinem Ticket."

#: includes/premium/integrations/eventin.php:3169
msgid "Eventin – Event Management"
msgstr "Eventin – Event-Verwaltung"

#: includes/premium/integrations/eventin.php:3170
msgid "Read and manage Eventin. Events: list_events, get_event, create_event, update_event, set_event_status, trash_event, delete_event_permanently, upcoming_events. People: list_speakers, get_speaker, speaker_events, list_organizers, get_organizer, organizer_events. Agenda: list_schedules, get_schedule, event_schedule. Tickets: list_ticket_types, ticket_availability. Attendees: list_attendees, get_attendee, count_attendees, list_checkins. Money: event_revenue. Configuration: event_settings. And audit_calendar, which reports what is wrong with the calendar. delete_event_permanently is irreversible and destroys the event its attendee records hang off, leaving every booking for it unreadable; it requires confirm: true. Attendee reads need the etn_manage_attendee capability. There is no refund or cancel action."
msgstr "Eventin lesen und verwalten. Events: list_events, get_event, create_event, update_event, set_event_status, trash_event, delete_event_permanently, upcoming_events. Personen: list_speakers, get_speaker, speaker_events, list_organizers, get_organizer, organizer_events. Programm: list_schedules, get_schedule, event_schedule. Tickets: list_ticket_types, ticket_availability. Teilnehmer: list_attendees, get_attendee, count_attendees, list_checkins. Geld: event_revenue. Konfiguration: event_settings. Und audit_calendar, das meldet, was mit dem Kalender nicht stimmt. delete_event_permanently ist unumkehrbar und zerstört das Event, an dem die Teilnehmerdatensätze hängen, wodurch jede Buchung dafür unlesbar wird; es erfordert confirm: true. Das Lesen von Teilnehmern erfordert die Berechtigung etn_manage_attendee. Es gibt keine Aktion zum Erstatten oder Stornieren."

#. translators: 1: the action requested, 2: comma separated list of valid actions
#: includes/premium/integrations/eventin.php:3318
#: includes/premium/integrations/eventprime.php:2682
#: includes/premium/integrations/events.php:2791
#, php-format
msgid "Unknown action \"%1$s\". This hub offers: %2$s."
msgstr "Unbekannte Aktion \"%1$s\". Dieser Hub bietet: %2$s."

#: includes/premium/integrations/eventprime.php:149
msgid "EventPrime is not active on this site."
msgstr "EventPrime ist auf dieser Website nicht aktiv."

#. translators: %d: term ID
#: includes/premium/integrations/eventprime.php:299
#, php-format
msgid "No term with the id %d exists on this site."
msgstr "Auf dieser Website existiert kein Begriff mit der ID %d."

#. translators: 1: term ID, 2: actual taxonomy, 3: expected taxonomy
#: includes/premium/integrations/eventprime.php:311
#, php-format
msgid "Term %1$d belongs to \"%2$s\", not to \"%3$s\". Refusing on the taxonomy before considering permissions."
msgstr "Begriff %1$d gehört zu \"%2$s\", nicht zu \"%3$s\". Abgelehnt aufgrund der Taxonomie, noch vor der Berechtigungsprüfung."

#. translators: %s: the timezone that was sent
#: includes/premium/integrations/eventprime.php:400
#, php-format
msgid "\"%s\" is not a timezone this site knows. Send an Olson name such as Europe/Rome."
msgstr "\"%s\" ist keine Zeitzone, die diese Website kennt. Sende einen Olson-Namen wie Europe/Rome."

#: includes/premium/integrations/eventprime.php:417
msgid "A date is required and was empty."
msgstr "Ein Datum ist erforderlich und war leer."

#. translators: 1: the date that was sent, 2: comma separated list of accepted formats
#: includes/premium/integrations/eventprime.php:444
#, php-format
msgid "\"%1$s\" is not a date this hub will guess at. Accepted: %2$s."
msgstr "\"%1$s\" ist kein Datum, das dieser Hub errät. Akzeptiert: %2$s."

#: includes/premium/integrations/eventprime.php:558
msgid "This event is missing part of its date set, so EventPrime will not list it anywhere. Send update_event with a start_date to repair it."
msgstr "Diesem Event fehlt ein Teil seiner Datumsangaben, daher listet EventPrime es nirgends auf. Sende update_event mit einem start_date, um es zu reparieren."

#: includes/premium/integrations/eventprime.php:735
msgid "Not on the allow-list."
msgstr "Nicht auf der Erlaubnisliste."

#: includes/premium/integrations/eventprime.php:745
msgid "Allowed by name but holds a structure, which is dropped rather than flattened."
msgstr "Namentlich erlaubt, enthält aber eine Struktur, die verworfen statt abgeflacht wird."

#. translators: 1: the status that was sent, 2: comma separated list of valid statuses
#: includes/premium/integrations/eventprime.php:840
#, php-format
msgid "\"%1$s\" is not a status. This hub accepts: %2$s."
msgstr "\"%1$s\" ist kein Status. Dieser Hub akzeptiert: %2$s."

#: includes/premium/integrations/eventprime.php:889
msgid "The end of the range is before its start."
msgstr "Das Ende des Bereichs liegt vor seinem Beginn."

#: includes/premium/integrations/eventprime.php:1037
msgid "Ordered by em_start_date_time, which is an inner join: an event missing that key is absent from this list and from EventPrime's own."
msgstr "Sortiert nach em_start_date_time, was ein Inner Join ist: Ein Event ohne diesen Schlüssel fehlt in dieser Liste und auch in der von EventPrime selbst."

#: includes/premium/integrations/eventprime.php:1042
msgid "Rows this account may not edit were left out rather than silently shortening the list."
msgstr "Zeilen, die dieses Konto nicht bearbeiten darf, wurden ausgelassen und nicht still aus der Liste gekürzt."

#: includes/premium/integrations/eventprime.php:1060
#: includes/premium/integrations/events-manager.php:1385
#: includes/premium/integrations/events.php:1463
msgid "Reading this event"
msgstr "Dieses Event lesen"

#: includes/premium/integrations/eventprime.php:1100
#: includes/premium/integrations/eventprime.php:1191
msgid "event_data is required and was empty."
msgstr "event_data ist erforderlich und war leer."

#: includes/premium/integrations/eventprime.php:1106
msgid "event_data.title is required."
msgstr "event_data.title ist erforderlich."

#: includes/premium/integrations/eventprime.php:1110
msgid "event_data.start_date is required. An event with no start date exists nowhere EventPrime can see it."
msgstr "event_data.start_date ist erforderlich. Ein Event ohne Startdatum existiert nirgends, wo EventPrime es sehen kann."

#: includes/premium/integrations/eventprime.php:1122
msgid "An event may be created as publish, draft, pending, private or future."
msgstr "Ein Event kann als publish, draft, pending, private oder future erstellt werden."

#: includes/premium/integrations/eventprime.php:1151
msgid "WordPress refused to create the event."
msgstr "WordPress hat das Erstellen des Events verweigert."

#: includes/premium/integrations/eventprime.php:1185
#: includes/premium/integrations/events-manager.php:1724
#: includes/premium/integrations/events.php:1513
msgid "Updating this event"
msgstr "Dieses Event aktualisieren"

#: includes/premium/integrations/eventprime.php:1200
msgid "event_data.title cannot be emptied."
msgstr "event_data.title darf nicht geleert werden."

#: includes/premium/integrations/eventprime.php:1287
msgid "A start_date is required: this event has none stored to fall back on."
msgstr "Ein start_date ist erforderlich: Dieses Event hat keines gespeichert, auf das zurückgegriffen werden könnte."

#: includes/premium/integrations/eventprime.php:1313
msgid "The end is before the start. Refusing rather than reordering them, because a swapped pair is usually a wrong month."
msgstr "Das Ende liegt vor dem Beginn. Abgelehnt, statt sie umzusortieren, denn ein vertauschtes Paar ist meist ein falscher Monat."

#: includes/premium/integrations/eventprime.php:1366
msgid "Changing this event's status"
msgstr "Den Status dieses Events ändern"

#: includes/premium/integrations/eventprime.php:1372
msgid "A status of publish, draft, pending, private or future is required."
msgstr "Ein Status publish, draft, pending, private oder future ist erforderlich."

#: includes/premium/integrations/eventprime.php:1378
msgid "Refusing to publish an event whose date set is incomplete: it would be live and invisible. Send update_event with a start_date first."
msgstr "Ein Event mit unvollständigen Datumsangaben wird nicht veröffentlicht: Es wäre live und unsichtbar. Sende zuerst update_event mit einem start_date."

#: includes/premium/integrations/eventprime.php:1403
#: includes/premium/integrations/events.php:1626
msgid "Trashing this event"
msgstr "Dieses Event in den Papierkorb verschieben"

#: includes/premium/integrations/eventprime.php:1411
msgid "The event is in the trash and can be restored from wp-admin. Its bookings are untouched."
msgstr "Das Event liegt im Papierkorb und kann im wp-admin wiederhergestellt werden. Seine Buchungen bleiben unberührt."

#: includes/premium/integrations/eventprime.php:1436
msgid "Deleting this event"
msgstr "Dieses Event löschen"

#: includes/premium/integrations/eventprime.php:1442
msgid "This is irreversible and it orphans every booking for the event. Send confirm true once the owner has agreed."
msgstr "Das ist unumkehrbar und lässt jede Buchung für das Event verwaisen. Sende confirm true, sobald der Betreiber zugestimmt hat."

#: includes/premium/integrations/eventprime.php:1454
msgid "Permanent. The event, its meta, its date set and its links to venue, type and organizer are gone, and every booking that pointed at it now points at nothing. Those bookings still hold attendee data and are listed by audit_events as orphans."
msgstr "Endgültig. Das Event, seine Metadaten, seine Datumsangaben und seine Verknüpfungen zu Ort, Typ und Veranstalter sind weg, und jede Buchung, die darauf verwies, verweist jetzt ins Leere. Diese Buchungen enthalten noch Teilnehmerdaten und werden von audit_events als verwaist aufgeführt."

#: includes/premium/integrations/eventprime.php:1463
msgid "Listing venues, event types and organizers"
msgstr "Orte, Event-Typen und Veranstalter auflisten"

#: includes/premium/integrations/eventprime.php:1506
msgid "In EventPrime a venue, an event type and an organizer are taxonomy terms, not posts. Their ids are term ids."
msgstr "In EventPrime sind Ort, Event-Typ und Veranstalter Taxonomie-Begriffe, keine Beiträge. Ihre IDs sind Begriffs-IDs."

#: includes/premium/integrations/eventprime.php:1519
msgid "Reading a venue"
msgstr "Einen Ort lesen"

#: includes/premium/integrations/eventprime.php:1544
msgid "Creating a venue, event type or organizer"
msgstr "Einen Ort, Event-Typ oder Veranstalter erstellen"

#: includes/premium/integrations/eventprime.php:1553
#: includes/premium/integrations/eventprime.php:1727
msgid "A name is required."
msgstr "Ein Name ist erforderlich."

#: includes/premium/integrations/eventprime.php:1571
msgid "WordPress refused to create the term."
msgstr "WordPress hat das Erstellen des Begriffs verweigert."

#: includes/premium/integrations/eventprime.php:1588
msgid "Updating a venue"
msgstr "Einen Ort aktualisieren"

#: includes/premium/integrations/eventprime.php:1601
msgid "A venue name cannot be emptied."
msgstr "Ein Ortsname darf nicht geleert werden."

#: includes/premium/integrations/eventprime.php:1650
msgid "Listing performers"
msgstr "Künstler auflisten"

#: includes/premium/integrations/eventprime.php:1698
msgid "Reading this performer"
msgstr "Diesen Künstler lesen"

#: includes/premium/integrations/eventprime.php:1718
msgid "Creating a performer"
msgstr "Einen Künstler erstellen"

#: includes/premium/integrations/eventprime.php:1749
msgid "WordPress refused to create the performer."
msgstr "WordPress hat das Erstellen des Künstlers verweigert."

#: includes/premium/integrations/eventprime.php:1780
#: includes/premium/integrations/events-manager.php:2596
msgid "Listing bookings"
msgstr "Buchungen auflisten"

#: includes/premium/integrations/eventprime.php:1846
msgid "Attendee names, checkout answers, the order record, the payment log and the booking's order key are not on the allow-list and do not leave this hub at any size of listing."
msgstr "Teilnehmernamen, Antworten aus dem Checkout, der Bestelldatensatz, das Zahlungsprotokoll und der Bestellschlüssel der Buchung stehen nicht auf der Erlaubnisliste und verlassen diesen Hub bei keiner Listengröße."

#. translators: 1: the status that was sent, 2: comma separated list of valid statuses
#: includes/premium/integrations/eventprime.php:1864
#, php-format
msgid "\"%1$s\" is not a booking status. EventPrime writes: %2$s."
msgstr "\"%1$s\" ist kein Buchungsstatus. EventPrime schreibt: %2$s."

#: includes/premium/integrations/eventprime.php:1884
msgid "Reading a booking"
msgstr "Eine Buchung lesen"

#: includes/premium/integrations/eventprime.php:1891
#: includes/premium/integrations/events-manager.php:2672
msgid "Reading this booking"
msgstr "Diese Buchung lesen"

#: includes/premium/integrations/eventprime.php:1910
msgid "Attendee count only. The names behind it stay in wp-admin."
msgstr "Nur die Teilnehmerzahl. Die Namen dahinter bleiben im wp-admin."

#: includes/premium/integrations/eventprime.php:1947
#: includes/premium/integrations/events-manager.php:2744
msgid "Counting bookings"
msgstr "Buchungen zählen"

#: includes/premium/integrations/eventprime.php:2002
msgid "Counts only, over the booking's own em_date timestamp. No row of this answer names a person."
msgstr "Nur Zahlen, über den eigenen em_date-Zeitstempel der Buchung. Keine Zeile dieser Antwort nennt eine Person."

#: includes/premium/integrations/eventprime.php:2066
msgid "Reading attendance"
msgstr "Teilnahme lesen"

#: includes/premium/integrations/eventprime.php:2073
msgid "Reading this event's attendance"
msgstr "Die Teilnahme an diesem Event lesen"

#: includes/premium/integrations/eventprime.php:2105
msgid "Per-attendee check-in is written by EventPrime's check-in add-on behind a filter, not in meta this hub can read. No number is invented for it."
msgstr "Der Check-in pro Teilnehmer wird vom Check-in-Add-on von EventPrime hinter einem Filter geschrieben, nicht in Metadaten, die dieser Hub lesen kann. Dafür wird keine Zahl erfunden."

#: includes/premium/integrations/eventprime.php:2155
msgid "Reading this event's tickets"
msgstr "Die Tickets dieses Events lesen"

#: includes/premium/integrations/eventprime.php:2161
msgid "EventPrime's ticket table is not present, so this install has no ticket rows to read."
msgstr "Die Tickettabelle von EventPrime ist nicht vorhanden, daher hat diese Installation keine Ticketzeilen zum Lesen."

#: includes/premium/integrations/eventprime.php:2212
msgid "Seat maps, offers, visibility rules and additional fees are reported as present or absent. Their stored JSON does not travel."
msgstr "Sitzpläne, Angebote, Sichtbarkeitsregeln und Zusatzgebühren werden als vorhanden oder nicht vorhanden gemeldet. Ihr gespeichertes JSON geht nicht hinaus."

#: includes/premium/integrations/eventprime.php:2235
msgid "Reading this event's capacity"
msgstr "Die Kapazität dieses Events lesen"

#: includes/premium/integrations/eventprime.php:2252
msgid "Capacity in EventPrime is per ticket row, and one booking can hold several tickets, so bookings_active is a floor on seats taken rather than an exact count."
msgstr "Die Kapazität gilt in EventPrime pro Ticketzeile, und eine Buchung kann mehrere Tickets enthalten, daher ist bookings_active eine Untergrenze der belegten Plätze und keine exakte Zahl."

#: includes/premium/integrations/eventprime.php:2298
#: includes/premium/integrations/events.php:2259
msgid "Reading the calendar"
msgstr "Den Kalender lesen"

#: includes/premium/integrations/eventprime.php:2311
#: includes/premium/integrations/events.php:2266
msgid "calendar_between needs both from_date and to_date."
msgstr "calendar_between braucht sowohl from_date als auch to_date."

#: includes/premium/integrations/eventprime.php:2352
msgid "Events this account may not edit were left out."
msgstr "Events, die dieses Konto nicht bearbeiten darf, wurden ausgelassen."

#: includes/premium/integrations/eventprime.php:2361
#: includes/premium/integrations/events.php:2326
msgid "Reading upcoming events"
msgstr "Anstehende Events lesen"

#: includes/premium/integrations/eventprime.php:2421
msgid "Reading EventPrime settings"
msgstr "EventPrime-Einstellungen lesen"

#: includes/premium/integrations/eventprime.php:2434
msgid "Payment credentials, licence data and the plugin's own API key are reported as present or absent and never as values."
msgstr "Zahlungszugangsdaten, Lizenzdaten und der eigene API-Schlüssel des Plugins werden als vorhanden oder nicht vorhanden gemeldet und nie als Werte."

#: includes/premium/integrations/eventprime.php:2450
msgid "Auditing events"
msgstr "Events prüfen"

#: includes/premium/integrations/eventprime.php:2532
msgid "Events this account may not edit were not examined."
msgstr "Events, die dieses Konto nicht bearbeiten darf, wurden nicht untersucht."

#: includes/premium/integrations/eventprime.php:2545
msgid "Finding orphaned bookings means reading bookings, which this account may not do."
msgstr "Verwaiste Buchungen zu finden heißt Buchungen zu lesen, und das darf dieses Konto nicht."

#: includes/premium/integrations/eventprime.php:2582
msgid "The booking still holds attendee data but its event no longer exists."
msgstr "Die Buchung enthält noch Teilnehmerdaten, aber ihr Event existiert nicht mehr."

#: includes/premium/integrations/eventprime.php:2701
msgid "EventPrime – Management"
msgstr "EventPrime – Verwaltung"

#: includes/premium/integrations/eventprime.php:2702
msgid "Read and manage EventPrime. Events: list_events, get_event, create_event, update_event, set_event_status, trash_event, delete_event_permanently. Venues: list_venues, get_venue, create_venue, update_venue. Event types: list_event_types, create_event_type. Organizers: list_organizers. Performers: list_performers, get_performer, create_performer. Bookings: list_bookings, get_booking, count_bookings, event_attendance. Capacity: event_capacity, list_tickets. Calendar: calendar_between, upcoming_events. Plus get_settings and audit_events, which reports what is wrong with the calendar."
msgstr "EventPrime lesen und verwalten. Events: list_events, get_event, create_event, update_event, set_event_status, trash_event, delete_event_permanently. Veranstaltungsorte: list_venues, get_venue, create_venue, update_venue. Event-Typen: list_event_types, create_event_type. Veranstalter: list_organizers. Künstler: list_performers, get_performer, create_performer. Buchungen: list_bookings, get_booking, count_bookings, event_attendance. Kapazität: event_capacity, list_tickets. Kalender: calendar_between, upcoming_events. Dazu get_settings und audit_events, das meldet, was mit dem Kalender nicht stimmt."

#: includes/premium/integrations/events-manager.php:115
msgid "Events Manager is not active on this site."
msgstr "Events Manager ist auf dieser Website nicht aktiv."

#. translators: %s: PHP constant name
#: includes/premium/integrations/events-manager.php:228
#, php-format
msgid "Events Manager has not defined %s yet, so its tables cannot be read."
msgstr "Events Manager hat %s noch nicht definiert, daher können seine Tabellen nicht gelesen werden."

#. translators: %s: PHP constant name
#: includes/premium/integrations/events-manager.php:245
#, php-format
msgid "The table name in %s is not a plain identifier, so it will not be used in a query."
msgstr "Der Tabellenname in %s ist kein einfacher Bezeichner und wird daher in keiner Abfrage verwendet."

#: includes/premium/integrations/events-manager.php:361
msgid "status must be one of publish, pending, draft, trash."
msgstr "status muss publish, pending, draft oder trash sein."

#. translators: %d: event ID
#: includes/premium/integrations/events-manager.php:542
#, php-format
msgid "No Events Manager event row has the id %d."
msgstr "Keine Events-Manager-Event-Zeile hat die ID %d."

#. translators: 1: event ID, 2: post ID, 3: the post type found, or "nothing"
#: includes/premium/integrations/events-manager.php:564
#, php-format
msgid "Event row %1$d points at post %2$d, which is a \"%3$s\" and not an event. Refusing on the type before considering permissions."
msgstr "Event-Zeile %1$d verweist auf Beitrag %2$d, der ein \"%3$s\" und kein Event ist. Abgelehnt aufgrund des Typs, noch vor der Berechtigungsprüfung."

#: includes/premium/integrations/events-manager.php:588
msgid "A positive location_id is required."
msgstr "Eine positive location_id ist erforderlich."

#. translators: %d: location ID
#: includes/premium/integrations/events-manager.php:610
#, php-format
msgid "No Events Manager location row has the id %d."
msgstr "Keine Events-Manager-Ortszeile hat die ID %d."

#. translators: 1: location ID, 2: post ID, 3: the post type found, or "nothing"
#: includes/premium/integrations/events-manager.php:629
