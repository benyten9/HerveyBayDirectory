#: includes/oauth/oauth-connect-tab.php:760
msgid "Paste it into your AI client."
msgstr "Füge sie in deinen KI-Client ein."

#: includes/oauth/oauth-connect-tab.php:761
msgid "Your browser opens here, already signed in."
msgstr "Dein Browser öffnet sich hier, bereits angemeldet."

#: includes/oauth/oauth-connect-tab.php:762
msgid "Approve what it may do."
msgstr "Bestätige, was er darf."

#: includes/oauth/oauth-connect-tab.php:786
msgid "Not available for this site"
