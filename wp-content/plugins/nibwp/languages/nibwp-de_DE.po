msgid "Open <strong>Zed</strong>."
msgstr "Öffne <strong>Zed</strong>."

#: includes/helpers.php:1830
msgid "Open Settings: <kbd>Cmd</kbd>+<kbd>,</kbd> (Mac) / <kbd>Ctrl</kbd>+<kbd>,</kbd> (Linux)."
