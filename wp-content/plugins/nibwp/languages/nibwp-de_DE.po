msgstr "Senden Sie redirect_type: 301, 302, 307 oder global."

#: includes/premium/integrations/thirstyaffiliates.php:1036
msgid "Send at least one of no_follow, new_window, pass_query_str, uncloak_link, rel_tags, css_classes."
msgstr "Senden Sie mindestens eines von no_follow, new_window, pass_query_str, uncloak_link, rel_tags, css_classes."

