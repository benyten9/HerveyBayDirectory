msgstr "Es gibt keine Gruppe %d."

#: includes/premium/integrations/buddypress.php:610
msgid "Give the activity item as activity_id."
msgstr "Gib den Aktivitätseintrag als activity_id an."

#: includes/premium/integrations/buddypress.php:614
msgid "This version of BuddyPress does not expose single activity items where this integration can read them."
msgstr "Diese Version von BuddyPress stellt einzelne Aktivitätseinträge nicht so bereit, dass diese Integration sie lesen kann."

#. translators: %d: activity ID
#: includes/premium/integrations/buddypress.php:631
#: includes/premium/integrations/buddypress.php:2489
#, php-format
msgid "There is no activity item %d."
msgstr "Es gibt keinen Aktivitätseintrag %d."

