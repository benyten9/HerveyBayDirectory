#: includes/premium/integrations/blocksy.php:1419
#: includes/premium/integrations/blocksy.php:1486
#, php-format
msgid "Unknown option group \"%1$s\". Valid groups: %2$s."
msgstr "Unbekannte Optionsgruppe \"%1$s\". Gültige Gruppen: %2$s."

#: includes/premium/integrations/blocksy.php:1494
msgid "Name some keys, or a group. Reading every theme mod at once is how a response becomes unreadable."
msgstr "Nenne einige Schlüssel oder eine Gruppe. Alle Theme-Mods auf einmal zu lesen macht eine Antwort unlesbar."

#: includes/premium/integrations/blocksy.php:1548
msgid "Provide a non-empty \"options\" object of theme-mod key to value."
msgstr "Gib ein nicht leeres \"options\"-Objekt mit Theme-Mod-Schlüssel und Wert an."

#: includes/premium/integrations/blocksy.php:1603
msgid "Name the theme-mod keys to reset. There is no action that resets every option at once."
msgstr "Nenne die Theme-Mod-Schlüssel, die zurückgesetzt werden sollen. Es gibt keine Aktion, die alle Optionen auf einmal zurücksetzt."

#: includes/premium/integrations/blocksy.php:1731
msgid "Provide a non-empty \"palette\" object, normally color1..color8 each holding {color: \"#hex\"}."
msgstr "Gib ein nicht leeres \"palette\"-Objekt an, normalerweise color1..color8, jeweils mit {color: \"#hex\"}."

#: includes/premium/integrations/blocksy.php:1817
#: includes/premium/integrations/blocksy.php:1855
msgid "A palette \"name\" is required."
msgstr "Ein Paletten-\"name\" ist erforderlich."

#: includes/premium/integrations/blocksy.php:1821
msgid "Provide a non-empty \"palette\" object to save."
msgstr "Gib ein nicht leeres \"palette\"-Objekt zum Speichern an."

#: includes/premium/integrations/blocksy.php:1861
msgid "No saved palette has that name."
msgstr "Keine gespeicherte Palette hat diesen Namen."

#: includes/premium/integrations/blocksy.php:1943
msgid "Provide a non-empty \"options\" object of typography theme-mod key to value."
msgstr "Gib ein nicht leeres \"options\"-Objekt mit Typografie-Theme-Mod-Schlüssel und Wert an."

#. translators: %s: the keys that were refused
#: includes/premium/integrations/blocksy.php:1967
#, php-format
msgid "None of those keys read as typography: %s. Run get_typography to see the keys this site has."
msgstr "Keiner dieser Schlüssel gehört zur Typografie: %s. Führe get_typography aus, um die Schlüssel dieser Website zu sehen."

#: includes/premium/integrations/blocksy.php:2102
msgid "Reading a post's Blocksy overrides"
msgstr "Die Blocksy-Überschreibungen eines Beitrags lesen"

#: includes/premium/integrations/blocksy.php:2143
msgid "Writing a post's Blocksy overrides"
msgstr "Die Blocksy-Überschreibungen eines Beitrags schreiben"

#: includes/premium/integrations/blocksy.php:2152
msgid "Provide a non-empty \"overrides\" object."
msgstr "Gib ein nicht leeres \"overrides\"-Objekt an."

#: includes/premium/integrations/blocksy.php:2158
msgid "The override meta key could not be resolved. Pass \"meta_key\" explicitly."
msgstr "Der Meta-Schlüssel für Überschreibungen konnte nicht ermittelt werden. Übergib \"meta_key\" ausdrücklich."

#: includes/premium/integrations/blocksy.php:2199
msgid "Clearing a post's Blocksy overrides"
msgstr "Die Blocksy-Überschreibungen eines Beitrags löschen"

#: includes/premium/integrations/blocksy.php:2333
msgid "Reading a Content Block"
msgstr "Einen Content Block lesen"

#: includes/premium/integrations/blocksy.php:2379
msgid "A \"title\" is required for a new Content Block."
msgstr "Ein \"title\" ist für einen neuen Content Block erforderlich."

#: includes/premium/integrations/blocksy.php:2447
msgid "Setting a Content Block's display conditions"
msgstr "Die Anzeigebedingungen eines Content Blocks festlegen"

#: includes/premium/integrations/blocksy.php:2454
msgid "Provide a \"conditions\" array, in the shape get_content_block reports."
msgstr "Gib ein \"conditions\"-Array an, in der Form, die get_content_block meldet."

#: includes/premium/integrations/blocksy.php:2511
msgid "Deleting a Content Block"
msgstr "Einen Content Block löschen"

#. translators: %s: the content block's title
#: includes/premium/integrations/blocksy.php:2524
#, php-format
msgid "Pass the block's exact title in \"confirm\" to delete it: %s"
msgstr "Übergib den exakten Titel des Blocks in \"confirm\", um ihn zu löschen: %s"

#: includes/premium/integrations/blocksy.php:2639
msgid "An \"extension\" slug is required. Run list_extensions for the slugs."
msgstr "Ein \"extension\"-Slug ist erforderlich. Führe list_extensions für die Slugs aus."

#. translators: %s: the extension slug given
#: includes/premium/integrations/blocksy.php:2649
#, php-format
msgid "No Blocksy Companion extension is called \"%s\". Run list_extensions for the slugs this build knows."
msgstr "Keine Blocksy-Companion-Erweiterung heißt \"%s\". Führe list_extensions für die Slugs aus, die dieser Build kennt."

#: includes/premium/integrations/blocksy.php:2657
msgid "Pass \"enabled\" true or false."
msgstr "Übergib \"enabled\" als true oder false."

#: includes/premium/integrations/bricksed.php:47
msgid "Bricksed — Manage Library"
msgstr "Bricksed – Bibliothek verwalten"

#: includes/premium/integrations/bricksed.php:108
msgid "Bricksed is not active on this site."
msgstr "Bricksed ist auf dieser Website nicht aktiv."

#: includes/premium/integrations/bricksed.php:118
#: includes/premium/integrations/etchedy.php:116
msgid "An \"id\" is required. Call \"list\" to see the available ids."
msgstr "Eine \"id\" ist erforderlich. Rufe \"list\" auf, um die verfügbaren IDs zu sehen."

#: includes/premium/integrations/bricksed.php:179
#: includes/premium/integrations/etchedy.php:176
msgid "A \"name\" is required for the copy."
msgstr "Für die Kopie ist ein \"name\" erforderlich."

#: includes/premium/integrations/bricksed.php:200
#: includes/premium/integrations/etchedy.php:197
msgid "\"folders\" is required and replaces the whole folder structure. Read it with \"folders\" first, change it, and send all of it back."
msgstr "\"folders\" ist erforderlich und ersetzt die gesamte Ordnerstruktur. Lies sie zuerst mit \"folders\", ändere sie und sende alles zurück."

#: includes/premium/integrations/bricksed.php:222
#: includes/premium/integrations/etchedy.php:219
#, php-format
msgid "Unknown action \"%s\"."
msgstr "Unbekannte Aktion \"%s\"."

#: includes/premium/integrations/bricksed.php:254
#: includes/premium/integrations/etchedy.php:251
msgid "Not written: something in this component is true of this site alone and would break on any other. Fix the rules below and try again."
msgstr "Nicht geschrieben: Etwas in dieser Komponente gilt nur für diese Website und würde auf jeder anderen kaputtgehen. Behebe die Regeln unten und versuch es erneut."

#: includes/premium/integrations/bricksed.php:284
#: includes/premium/integrations/etchedy.php:281
msgid "A \"name\" is required to rename."
msgstr "Zum Umbenennen ist ein \"name\" erforderlich."

#: includes/premium/integrations/bricksed.php:311
#: includes/premium/integrations/etchedy.php:308
msgid "This stored component has no type recorded, so it cannot be updated as it is. Pass the \"type\" it should have (layout, element, component or template)."
msgstr "Für diese gespeicherte Komponente ist kein Typ erfasst, daher kann sie so nicht aktualisiert werden. Übergib den \"type\", den sie haben soll (layout, element, component oder template)."

#: includes/premium/integrations/bricksed.php:324
#: includes/premium/integrations/etchedy.php:321
msgid "update and rename cannot change where a component lives: the file stays where it is, so the details and the folder would disagree. Use \"move\" to put it in another type or category."
msgstr "update und rename können nicht ändern, wo eine Komponente liegt: Die Datei bleibt, wo sie ist, und dann würden Details und Ordner nicht übereinstimmen. Verwende \"move\", um sie in einen anderen Typ oder eine andere Kategorie zu verschieben."

#: includes/premium/integrations/bricksed.php:446
#: includes/premium/integrations/etchedy.php:443
msgid "That is where the component already is. Give a different \"type\" or \"category\" to move it."
msgstr "Dort liegt die Komponente bereits. Gib einen anderen \"type\" oder eine andere \"category\" an, um sie zu verschieben."

#: includes/premium/integrations/bricksed.php:481
#: includes/premium/integrations/etchedy.php:478
msgid "The copy was saved in the new location, but the original could not be removed and is still in its old folder. Delete it once you have checked the copy."
msgstr "Die Kopie wurde am neuen Ort gespeichert, aber das Original konnte nicht entfernt werden und liegt noch im alten Ordner. Lösche es, sobald du die Kopie geprüft hast."

#: includes/premium/integrations/buddypress.php:84
msgid "BuddyPress is not active on this site."
msgstr "BuddyPress ist auf dieser Website nicht aktiv."

#. translators: %s: BuddyPress component name
#: includes/premium/integrations/buddypress.php:109
#, php-format
msgid "This version of BuddyPress does not report whether its %s component is active, so nothing here will call into it."
msgstr "Diese Version von BuddyPress meldet nicht, ob ihre Komponente %s aktiv ist, daher ruft nichts hier sie auf."

#. translators: %s: BuddyPress component name
#: includes/premium/integrations/buddypress.php:127
#, php-format
msgid "The BuddyPress %s component is switched off on this site, so there is nothing here to read or change. Switch it on under Settings > BuddyPress > Components first."
msgstr "Die BuddyPress-Komponente %s ist auf dieser Website ausgeschaltet, daher gibt es hier nichts zu lesen oder zu ändern. Schalte sie zuerst unter Einstellungen > BuddyPress > Komponenten ein."

#. translators: 1: what was being attempted, 2: capability name, 3: alternative capability name
#: includes/premium/integrations/buddypress.php:144
#, php-format
msgid "%1$s needs the %2$s or %3$s capability, which this account does not have."
msgstr "%1$s braucht die Berechtigung %2$s oder %3$s, die dieses Konto nicht hat."

#. translators: 1: what was being attempted, 2: member ID
#: includes/premium/integrations/buddypress.php:186
#, php-format
msgid "%1$s is refused: this account cannot edit member %2$d, so it does not get that member's record."
msgstr "%1$s wird abgelehnt: Dieses Konto kann Mitglied %2$d nicht bearbeiten und bekommt daher dessen Datensatz nicht."

#: includes/premium/integrations/buddypress.php:484
#: includes/premium/integrations/buddypress.php:1463
msgid "This version of BuddyPress does not expose its profile field groups where this integration can read them."
msgstr "Diese Version von BuddyPress stellt ihre Profilfeldgruppen nicht so bereit, dass diese Integration sie lesen kann."

#: includes/premium/integrations/buddypress.php:562
msgid "Only fields the member left public are returned. A field marked friends-only, logged-in-only or admins-only is named with its level and nothing else, however much authority the caller has."
msgstr "Nur Felder, die das Mitglied öffentlich gelassen hat, werden zurückgegeben. Ein Feld, das nur für Freunde, nur für Angemeldete oder nur für Admins sichtbar ist, wird nur mit seiner Stufe genannt und sonst nichts, egal wie viele Rechte der Aufrufer hat."

#: includes/premium/integrations/buddypress.php:578
msgid "Give the group as group_id."
msgstr "Gib die Gruppe als group_id an."

#: includes/premium/integrations/buddypress.php:582
msgid "This version of BuddyPress does not expose its groups where this integration can read them."
msgstr "Diese Version von BuddyPress stellt ihre Gruppen nicht so bereit, dass diese Integration sie lesen kann."

#. translators: %d: group ID
#: includes/premium/integrations/buddypress.php:592
#, php-format
