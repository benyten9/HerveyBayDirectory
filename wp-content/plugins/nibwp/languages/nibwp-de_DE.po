#: includes/helpers.php:1771
msgid "Open the <strong>Claude Desktop</strong> app on your computer."
msgstr "Öffne die App <strong>Claude Desktop</strong> auf deinem Computer."

#: includes/helpers.php:1772
msgid "Click your name in the bottom-left corner, then choose <strong>Settings</strong>."
msgstr "Klicke unten links auf deinen Namen und wähle dann <strong>Settings</strong>."

#: includes/helpers.php:1773
msgid "In Settings, click the <strong>Developer</strong> tab on the left."
msgstr "Klicke in den Einstellungen links auf den Tab <strong>Developer</strong>."

#: includes/helpers.php:1774
msgid "Click the <strong>Edit Config</strong> button — your text editor opens automatically."
msgstr "Klicke auf die Schaltfläche <strong>Edit Config</strong> – dein Texteditor öffnet sich automatisch."

#: includes/helpers.php:1775
msgid "Paste the snippet above into that file, then <strong>save</strong> and <strong>fully restart Claude Desktop</strong>."
msgstr "Füge das Snippet oben in diese Datei ein, <strong>speichere</strong> sie und <strong>starte Claude Desktop komplett neu</strong>."

#: includes/helpers.php:1778
msgid "Open <strong>Cursor</strong>."
msgstr "Öffne <strong>Cursor</strong>."

#: includes/helpers.php:1779
msgid "Press <kbd>Cmd</kbd>+<kbd>,</kbd> (Mac) or <kbd>Ctrl</kbd>+<kbd>,</kbd> (Windows/Linux) to open Settings."
msgstr "Drücke <kbd>Cmd</kbd>+<kbd>,</kbd> (Mac) oder <kbd>Ctrl</kbd>+<kbd>,</kbd> (Windows/Linux), um die Einstellungen zu öffnen."

#: includes/helpers.php:1780
msgid "In the search box, type <strong>MCP</strong>, then click <strong>Add new global MCP server</strong>."
msgstr "Gib im Suchfeld <strong>MCP</strong> ein und klicke dann auf <strong>Add new global MCP server</strong>."

#: includes/helpers.php:1781
msgid "Paste the snippet above into the file that opens. Save and reload Cursor."
msgstr "Füge das Snippet oben in die geöffnete Datei ein. Speichere und lade Cursor neu."

#: includes/helpers.php:1784
msgid "Open <strong>VS Code</strong>."
msgstr "Öffne <strong>VS Code</strong>."

#: includes/helpers.php:1785
msgid "Press <kbd>Cmd</kbd>+<kbd>Shift</kbd>+<kbd>P</kbd> (Mac) or <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>P</kbd> (Windows/Linux)."
msgstr "Drücke <kbd>Cmd</kbd>+<kbd>Shift</kbd>+<kbd>P</kbd> (Mac) oder <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>P</kbd> (Windows/Linux)."

#: includes/helpers.php:1786
msgid "Type <strong>MCP: Open User Configuration</strong> and press Enter."
msgstr "Gib <strong>MCP: Open User Configuration</strong> ein und drücke Enter."

#: includes/helpers.php:1787
msgid "Paste the snippet above into the file that opens. Save and reload VS Code."
msgstr "Füge das Snippet oben in die geöffnete Datei ein. Speichere und lade VS Code neu."

#: includes/helpers.php:1790
msgid "Open <strong>Windsurf</strong>."
msgstr "Öffne <strong>Windsurf</strong>."

#: includes/helpers.php:1791
msgid "Open the Cascade panel on the right side."
msgstr "Öffne rechts das Cascade-Panel."

#: includes/helpers.php:1792
msgid "Click the hammer/tools icon, then choose <strong>Configure MCP</strong>."
msgstr "Klicke auf das Hammer-/Tools-Symbol und wähle dann <strong>Configure MCP</strong>."

#: includes/helpers.php:1793
msgid "Paste the snippet above. Save and restart Windsurf."
msgstr "Füge das Snippet oben ein. Speichere und starte Windsurf neu."

#: includes/helpers.php:1796
msgid "In VS Code, click the <strong>Cline</strong> icon in the sidebar."
msgstr "Klicke in VS Code in der Seitenleiste auf das Symbol <strong>Cline</strong>."

#: includes/helpers.php:1797
msgid "At the top of Cline panel, click the ≡ menu and choose <strong>MCP Servers</strong>."
msgstr "Klicke oben im Cline-Panel auf das Menü ≡ und wähle <strong>MCP Servers</strong>."

#: includes/helpers.php:1798
msgid "Click <strong>Configure MCP Servers</strong> — a JSON file opens."
msgstr "Klicke auf <strong>Configure MCP Servers</strong> – eine JSON-Datei öffnet sich."

#: includes/helpers.php:1799
#: includes/helpers.php:1826
msgid "Paste the snippet above. Save the file."
msgstr "Füge das Snippet oben ein. Speichere die Datei."

#: includes/helpers.php:1802
msgid "In VS Code, click the <strong>Roo Code</strong> icon in the sidebar."
msgstr "Klicke in VS Code in der Seitenleiste auf das Symbol <strong>Roo Code</strong>."

#: includes/helpers.php:1803
msgid "Click the ≡ menu at the top, choose <strong>MCP Servers</strong>."
msgstr "Klicke oben auf das Menü ≡ und wähle <strong>MCP Servers</strong>."

#: includes/helpers.php:1804
msgid "Click <strong>Edit MCP Settings</strong>. Paste the snippet. Save."
msgstr "Klicke auf <strong>Edit MCP Settings</strong>. Füge das Snippet ein. Speichern."

#: includes/helpers.php:1807
msgid "Open your project in <strong>VS Code</strong>."
msgstr "Öffne dein Projekt in <strong>VS Code</strong>."

#: includes/helpers.php:1808
msgid "Create a folder called <code>.github/copilot</code> in your project if it doesn't exist."
msgstr "Lege in deinem Projekt einen Ordner <code>.github/copilot</code> an, falls er noch nicht existiert."

#: includes/helpers.php:1809
msgid "Inside it, create a file named <code>mcp.json</code>."
msgstr "Erstelle darin eine Datei namens <code>mcp.json</code>."

#: includes/helpers.php:1810
msgid "Paste the snippet above into that file. Save and reload Copilot."
msgstr "Füge das Snippet oben in diese Datei ein. Speichere und lade Copilot neu."

#: includes/helpers.php:1813
msgid "Open your <strong>Terminal</strong> (Mac) or <strong>PowerShell</strong> (Windows)."
msgstr "Öffne dein <strong>Terminal</strong> (Mac) oder <strong>PowerShell</strong> (Windows)."

#: includes/helpers.php:1814
msgid "Make sure <strong>Claude Code</strong> is installed (<code>npm install -g @anthropic-ai/claude-code</code>)."
msgstr "Stelle sicher, dass <strong>Claude Code</strong> installiert ist (<code>npm install -g @anthropic-ai/claude-code</code>)."

#: includes/helpers.php:1815
msgid "Paste and run the command shown above. It registers the MCP server globally."
msgstr "Füge den oben gezeigten Befehl ein und führe ihn aus. Er registriert den MCP-Server global."

#: includes/helpers.php:1816
msgid "Open Claude Code — the NIBWP tools are now available."
msgstr "Öffne Claude Code – die NIBWP-Tools sind jetzt verfügbar."

#: includes/helpers.php:1819
#: includes/helpers.php:1824
msgid "Open your <strong>Terminal</strong>."
msgstr "Öffne dein <strong>Terminal</strong>."

#: includes/helpers.php:1820
msgid "Edit the file at <code>~/.gemini/settings.json</code> (create it if missing)."
msgstr "Bearbeite die Datei <code>~/.gemini/settings.json</code> (lege sie an, falls sie fehlt)."

#: includes/helpers.php:1821
msgid "Paste the snippet above. Save the file. Restart Gemini CLI."
msgstr "Füge das Snippet oben ein. Speichere die Datei. Starte Gemini CLI neu."

#: includes/helpers.php:1825
msgid "Edit the file at <code>~/.codex/config.toml</code> (create it if missing)."
msgstr "Bearbeite die Datei <code>~/.codex/config.toml</code> (lege sie an, falls sie fehlt)."

