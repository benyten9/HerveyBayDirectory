msgstr "Não tem permissão para ligar um cliente de IA"

#: includes/oauth/oauth-consent.php:55
msgid "Connecting requires an administrator account on this site. Sign in as an administrator and try again."
msgstr "A ligação requer uma conta de administrador neste site. Inicie sessão como administrador e tente novamente."

#: includes/oauth/oauth-consent.php:62
#: includes/visual/visual-onboarding.php:25
