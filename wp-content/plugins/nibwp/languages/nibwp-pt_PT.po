#. translators: %s: comma-separated list of notification keys.
#: includes/premium/integrations/ultimate-member.php:2229
#: includes/premium/integrations/ultimate-member.php:2264
#, php-format
msgid "Unknown notification. This site has: %s"
msgstr "Notificação desconhecida. Este site tem: %s"

#: includes/premium/integrations/ultimate-member.php:2247
