msgid "Name the theme-mod keys to reset. There is no action that resets every option at once."
msgstr "Indique as chaves de theme mod a repor. Não existe nenhuma ação que reponha todas as opções de uma vez."

#: includes/premium/integrations/blocksy.php:1731
msgid "Provide a non-empty \"palette\" object, normally color1..color8 each holding {color: \"#hex\"}."
msgstr "Forneça um objeto \"palette\" não vazio, normalmente color1..color8, cada um com {color: \"#hex\"}."

#: includes/premium/integrations/blocksy.php:1817
#: includes/premium/integrations/blocksy.php:1855
msgid "A palette \"name\" is required."
msgstr "É necessário um \"name\" para a paleta."

#: includes/premium/integrations/blocksy.php:1821
msgid "Provide a non-empty \"palette\" object to save."
msgstr "Forneça um objeto \"palette\" não vazio para guardar."

#: includes/premium/integrations/blocksy.php:1861
msgid "No saved palette has that name."
msgstr "Nenhuma paleta guardada tem esse nome."

#: includes/premium/integrations/blocksy.php:1943
msgid "Provide a non-empty \"options\" object of typography theme-mod key to value."
msgstr "Forneça um objeto \"options\" não vazio com chave de theme mod de tipografia e valor."

#. translators: %s: the keys that were refused
#: includes/premium/integrations/blocksy.php:1967
#, php-format
msgid "None of those keys read as typography: %s. Run get_typography to see the keys this site has."
msgstr "Nenhuma dessas chaves parece ser de tipografia: %s. Execute get_typography para ver as chaves que este site tem."

#: includes/premium/integrations/blocksy.php:2102
msgid "Reading a post's Blocksy overrides"
msgstr "Ler as substituições do Blocksy de um artigo"

#: includes/premium/integrations/blocksy.php:2143
msgid "Writing a post's Blocksy overrides"
msgstr "Escrever as substituições do Blocksy de um artigo"

#: includes/premium/integrations/blocksy.php:2152
msgid "Provide a non-empty \"overrides\" object."
msgstr "Forneça um objeto \"overrides\" não vazio."

#: includes/premium/integrations/blocksy.php:2158
msgid "The override meta key could not be resolved. Pass \"meta_key\" explicitly."
msgstr "Não foi possível determinar a meta key das substituições. Passe \"meta_key\" explicitamente."

#: includes/premium/integrations/blocksy.php:2199
msgid "Clearing a post's Blocksy overrides"
msgstr "Limpar as substituições do Blocksy de um artigo"

#: includes/premium/integrations/blocksy.php:2333
msgid "Reading a Content Block"
msgstr "Ler um Content Block"

#: includes/premium/integrations/blocksy.php:2379
msgid "A \"title\" is required for a new Content Block."
msgstr "É necessário um \"title\" para um novo Content Block."

#: includes/premium/integrations/blocksy.php:2447
msgid "Setting a Content Block's display conditions"
msgstr "Definir as condições de apresentação de um Content Block"

#: includes/premium/integrations/blocksy.php:2454
msgid "Provide a \"conditions\" array, in the shape get_content_block reports."
msgstr "Forneça um array \"conditions\", no formato que get_content_block indica."

#: includes/premium/integrations/blocksy.php:2511
msgid "Deleting a Content Block"
msgstr "Eliminar um Content Block"

#. translators: %s: the content block's title
#: includes/premium/integrations/blocksy.php:2524
#, php-format
msgid "Pass the block's exact title in \"confirm\" to delete it: %s"
msgstr "Passe o título exato do bloco em \"confirm\" para o eliminar: %s"

#: includes/premium/integrations/blocksy.php:2639
msgid "An \"extension\" slug is required. Run list_extensions for the slugs."
msgstr "É necessário um slug de \"extension\". Execute list_extensions para ver os slugs."

#. translators: %s: the extension slug given
#: includes/premium/integrations/blocksy.php:2649
#, php-format
msgid "No Blocksy Companion extension is called \"%s\". Run list_extensions for the slugs this build knows."
msgstr "Nenhuma extensão do Blocksy Companion se chama \"%s\". Execute list_extensions para ver os slugs que esta versão conhece."

#: includes/premium/integrations/blocksy.php:2657
msgid "Pass \"enabled\" true or false."
msgstr "Passe \"enabled\" como true ou false."

#: includes/premium/integrations/bricksed.php:47
msgid "Bricksed — Manage Library"
msgstr "Bricksed — Gerir biblioteca"

#: includes/premium/integrations/bricksed.php:108
msgid "Bricksed is not active on this site."
msgstr "O Bricksed não está ativo neste site."

#: includes/premium/integrations/bricksed.php:118
#: includes/premium/integrations/etchedy.php:116
msgid "An \"id\" is required. Call \"list\" to see the available ids."
msgstr "É necessário um \"id\". Chame \"list\" para ver os ids disponíveis."

#: includes/premium/integrations/bricksed.php:179
#: includes/premium/integrations/etchedy.php:176
msgid "A \"name\" is required for the copy."
msgstr "É necessário um \"name\" para a cópia."

#: includes/premium/integrations/bricksed.php:200
#: includes/premium/integrations/etchedy.php:197
msgid "\"folders\" is required and replaces the whole folder structure. Read it with \"folders\" first, change it, and send all of it back."
msgstr "\"folders\" é obrigatório e substitui toda a estrutura de pastas. Leia-a primeiro com \"folders\", altere-a e envie-a de volta por inteiro."

#: includes/premium/integrations/bricksed.php:222
#: includes/premium/integrations/etchedy.php:219
#, php-format
msgid "Unknown action \"%s\"."
msgstr "Ação desconhecida \"%s\"."

#: includes/premium/integrations/bricksed.php:254
#: includes/premium/integrations/etchedy.php:251
msgid "Not written: something in this component is true of this site alone and would break on any other. Fix the rules below and try again."
msgstr "Não escrito: algo neste componente só é válido neste site e partir-se-ia em qualquer outro. Corrija as regras abaixo e tente novamente."

#: includes/premium/integrations/bricksed.php:284
#: includes/premium/integrations/etchedy.php:281
msgid "A \"name\" is required to rename."
msgstr "É necessário um \"name\" para mudar o nome."

#: includes/premium/integrations/bricksed.php:311
#: includes/premium/integrations/etchedy.php:308
msgid "This stored component has no type recorded, so it cannot be updated as it is. Pass the \"type\" it should have (layout, element, component or template)."
msgstr "Este componente guardado não tem tipo registado, por isso não pode ser atualizado tal como está. Passe o \"type\" que deve ter (layout, element, component ou template)."

#: includes/premium/integrations/bricksed.php:324
#: includes/premium/integrations/etchedy.php:321
msgid "update and rename cannot change where a component lives: the file stays where it is, so the details and the folder would disagree. Use \"move\" to put it in another type or category."
msgstr "update e rename não podem alterar onde um componente vive: o ficheiro fica onde está, por isso os detalhes e a pasta deixariam de coincidir. Use \"move\" para o pôr noutro tipo ou categoria."

#: includes/premium/integrations/bricksed.php:446
#: includes/premium/integrations/etchedy.php:443
msgid "That is where the component already is. Give a different \"type\" or \"category\" to move it."
msgstr "É aí que o componente já está. Indique um \"type\" ou uma \"category\" diferentes para o mover."

#: includes/premium/integrations/bricksed.php:481
#: includes/premium/integrations/etchedy.php:478
msgid "The copy was saved in the new location, but the original could not be removed and is still in its old folder. Delete it once you have checked the copy."
msgstr "A cópia foi guardada no novo local, mas não foi possível remover o original, que continua na pasta antiga. Elimine-o depois de verificar a cópia."

#: includes/premium/integrations/buddypress.php:84
msgid "BuddyPress is not active on this site."
msgstr "O BuddyPress não está ativo neste site."

#. translators: %s: BuddyPress component name
#: includes/premium/integrations/buddypress.php:109
#, php-format
msgid "This version of BuddyPress does not report whether its %s component is active, so nothing here will call into it."
msgstr "Esta versão do BuddyPress não indica se o seu componente %s está ativo, por isso nada aqui o vai chamar."

#. translators: %s: BuddyPress component name
#: includes/premium/integrations/buddypress.php:127
#, php-format
msgid "The BuddyPress %s component is switched off on this site, so there is nothing here to read or change. Switch it on under Settings > BuddyPress > Components first."
msgstr "O componente %s do BuddyPress está desligado neste site, por isso não há aqui nada para ler ou alterar. Ligue-o primeiro em Definições > BuddyPress > Componentes."

#. translators: 1: what was being attempted, 2: capability name, 3: alternative capability name
#: includes/premium/integrations/buddypress.php:144
#, php-format
msgid "%1$s needs the %2$s or %3$s capability, which this account does not have."
msgstr "%1$s requer a capacidade %2$s ou %3$s, que esta conta não tem."

#. translators: 1: what was being attempted, 2: member ID
#: includes/premium/integrations/buddypress.php:186
#, php-format
msgid "%1$s is refused: this account cannot edit member %2$d, so it does not get that member's record."
msgstr "%1$s foi recusado: esta conta não pode editar o membro %2$d, por isso não recebe o registo desse membro."

#: includes/premium/integrations/buddypress.php:484
#: includes/premium/integrations/buddypress.php:1463
msgid "This version of BuddyPress does not expose its profile field groups where this integration can read them."
msgstr "Esta versão do BuddyPress não expõe os seus grupos de campos de perfil num sítio onde esta integração os possa ler."

#: includes/premium/integrations/buddypress.php:562
msgid "Only fields the member left public are returned. A field marked friends-only, logged-in-only or admins-only is named with its level and nothing else, however much authority the caller has."
msgstr "Só são devolvidos os campos que o membro deixou públicos. Um campo marcado como só para amigos, só para utilizadores com sessão iniciada ou só para administradores é indicado com o seu nível e mais nada, seja qual for a autoridade de quem chama."

#: includes/premium/integrations/buddypress.php:578
msgid "Give the group as group_id."
msgstr "Indique o grupo como group_id."

#: includes/premium/integrations/buddypress.php:582
msgid "This version of BuddyPress does not expose its groups where this integration can read them."
msgstr "Esta versão do BuddyPress não expõe os seus grupos num sítio onde esta integração os possa ler."

#. translators: %d: group ID
#: includes/premium/integrations/buddypress.php:592
#, php-format
msgid "There is no group %d."
msgstr "Não existe o grupo %d."

#: includes/premium/integrations/buddypress.php:610
msgid "Give the activity item as activity_id."
msgstr "Indique o item de atividade como activity_id."

#: includes/premium/integrations/buddypress.php:614
msgid "This version of BuddyPress does not expose single activity items where this integration can read them."
msgstr "Esta versão do BuddyPress não expõe itens de atividade individuais num sítio onde esta integração os possa ler."

#. translators: %d: activity ID
#: includes/premium/integrations/buddypress.php:631
#: includes/premium/integrations/buddypress.php:2489
#, php-format
msgid "There is no activity item %d."
msgstr "Não existe o item de atividade %d."

#. translators: 1: action name, 2: list of valid actions
#: includes/premium/integrations/buddypress.php:892
#, php-format
msgid "Unknown BuddyPress action \"%1$s\". Valid actions: %2$s."
msgstr "Ação do BuddyPress desconhecida \"%1$s\". Ações válidas: %2$s."

#. translators: 1: action name, 2: error message from BuddyPress
#: includes/premium/integrations/buddypress.php:909
#, php-format
msgid "BuddyPress could not complete %1$s: %2$s"
msgstr "O BuddyPress não conseguiu concluir %1$s: %2$s"

#: includes/premium/integrations/buddypress.php:966
msgid "Reading the BuddyPress community summary"
msgstr "Ler o resumo da comunidade BuddyPress"

#. translators: %s: BuddyPress component label
#: includes/premium/integrations/buddypress.php:1003
#, php-format
msgid "The %s component is switched off, so nothing here reads or writes it."
msgstr "O componente %s está desligado, por isso nada aqui o lê ou escreve."

#: includes/premium/integrations/buddypress.php:1028
msgid "Auditing the BuddyPress community"
msgstr "Auditar a comunidade BuddyPress"

#: includes/premium/integrations/buddypress.php:1053
msgid "BuddyPress's own table names could not be resolved, so the audit will not guess at them."
msgstr "Não foi possível determinar os nomes das tabelas do próprio BuddyPress, por isso a auditoria não os vai adivinhar."

#: includes/premium/integrations/buddypress.php:1117
msgid "only organisers can invite people, yet anybody can read it"
msgstr "só os organizadores podem convidar pessoas, mas qualquer pessoa o pode ler"

#. translators: %s: the word found in the group name or description
#: includes/premium/integrations/buddypress.php:1124
#, php-format
msgid "its own description calls it \"%s\""
msgstr "a sua própria descrição chama-lhe \"%s\""

#: includes/premium/integrations/buddypress.php:1151
msgid "The activity table name could not be resolved, so orphaned activity was not looked for."
msgstr "Não foi possível determinar o nome da tabela de atividade, por isso não se procurou atividade órfã."

#: includes/premium/integrations/buddypress.php:1156
msgid "The users table name could not be resolved, so orphaned activity was not looked for."
msgstr "Não foi possível determinar o nome da tabela de utilizadores, por isso não se procurou atividade órfã."

#: includes/premium/integrations/buddypress.php:1173
msgid "The Activity component is switched off, so orphaned activity was not looked for."
msgstr "O componente Atividade está desligado, por isso não se procurou atividade órfã."

#: includes/premium/integrations/buddypress.php:1212
msgid "Each section is bounded, so a long list is a sample rather than the whole truth. Nothing here is acted on: a group that looks mislabelled may be deliberate, and deleting one is a decision for a person."
msgstr "Cada secção é limitada, por isso uma lista longa é uma amostra e não a verdade toda. Nada aqui é posto em prática: um grupo que parece mal rotulado pode ser intencional, e eliminar um é uma decisão para uma pessoa."

#: includes/premium/integrations/buddypress.php:1226
msgid "Listing BuddyPress members"
msgstr "Listar membros do BuddyPress"

#: includes/premium/integrations/buddypress.php:1245
msgid "Searching BuddyPress members"
msgstr "Pesquisar membros do BuddyPress"

#: includes/premium/integrations/buddypress.php:1256
msgid "Give something to search for as search."
msgstr "Indique algo para pesquisar como search."

#: includes/premium/integrations/buddypress.php:1271
msgid "This version of BuddyPress does not expose its member query where this integration can read it."
msgstr "Esta versão do BuddyPress não expõe a sua consulta de membros num sítio onde esta integração a possa ler."

#: includes/premium/integrations/buddypress.php:1317
#: includes/premium/integrations/buddypress.php:2015
msgid "Some members were left out because this account cannot edit them. The total counts them; the list does not."
msgstr "Alguns membros ficaram de fora porque esta conta não os pode editar. O total conta-os; a lista não."

#: includes/premium/integrations/buddypress.php:1333
#: includes/premium/integrations/buddypress.php:1538
#: includes/premium/integrations/buddypress.php:2031
#: includes/premium/integrations/buddypress.php:2086
#: includes/premium/integrations/buddypress.php:2132
msgid "Give the member as user_id."
msgstr "Indique o membro como user_id."

#: includes/premium/integrations/buddypress.php:1336
msgid "Reading a BuddyPress member"
msgstr "Ler um membro do BuddyPress"

#. translators: %d: member ID
#: includes/premium/integrations/buddypress.php:1351
#, php-format
msgid "There is no member %d."
msgstr "Não existe o membro %d."

#: includes/premium/integrations/buddypress.php:1379
msgid "The Extended Profiles component is switched off, so this member has no profile fields."
msgstr "O componente Perfis alargados está desligado, por isso este membro não tem campos de perfil."

#: includes/premium/integrations/buddypress.php:1392
msgid "Counting BuddyPress members"
msgstr "Contar membros do BuddyPress"

#: includes/premium/integrations/buddypress.php:1438
msgid "\"Active\" means the member has recorded activity at some point, not that they are online. \"Pending activation\" counts sign-ups that never confirmed, and is null on a site where BuddyPress does not keep that table."
msgstr "\"Ativo\" significa que o membro registou atividade em algum momento, não que está online. \"Ativação pendente\" conta registos nunca confirmados, e é null num site onde o BuddyPress não mantém essa tabela."

#: includes/premium/integrations/buddypress.php:1454
msgid "Reading the BuddyPress profile field groups"
msgstr "Ler os grupos de campos de perfil do BuddyPress"

#: includes/premium/integrations/buddypress.php:1523
msgid "This is the shape of the profile, not anybody's answers. default_visibility is what a field starts as, and members_may_override_visibility says whether a member is allowed to change it."
msgstr "Isto é a forma do perfil, não as respostas de ninguém. default_visibility é como um campo começa, e members_may_override_visibility diz se um membro o pode alterar."

#: includes/premium/integrations/buddypress.php:1541
msgid "Reading a BuddyPress member's profile fields"
msgstr "Ler os campos de perfil de um membro do BuddyPress"

#: includes/premium/integrations/buddypress.php:1570
msgid "Listing BuddyPress groups"
msgstr "Listar grupos do BuddyPress"

#: includes/premium/integrations/buddypress.php:1579
msgid "This version of BuddyPress does not expose its group query where this integration can read it."
msgstr "Esta versão do BuddyPress não expõe a sua consulta de grupos num sítio onde esta integração a possa ler."

#: includes/premium/integrations/buddypress.php:1631
msgid "Reading a BuddyPress group"
msgstr "Ler um grupo do BuddyPress"

#: includes/premium/integrations/buddypress.php:1679
msgid "This group is public: anybody can read it, including people who are not members and visitors who are not logged in."
msgstr "Este grupo é público: qualquer pessoa o pode ler, incluindo pessoas que não são membros e visitantes sem sessão iniciada."

#: includes/premium/integrations/buddypress.php:1692
msgid "Creating a BuddyPress group"
msgstr "Criar um grupo do BuddyPress"

#: includes/premium/integrations/buddypress.php:1701
msgid "This version of BuddyPress does not expose a way to create a group from here."
msgstr "Esta versão do BuddyPress não oferece forma de criar um grupo a partir daqui."

#: includes/premium/integrations/buddypress.php:1708
msgid "Give the group a name as group_data.name."
msgstr "Indique o nome do grupo como group_data.name."

#. translators: %s: list of valid group statuses
#: includes/premium/integrations/buddypress.php:1718
#, php-format
msgid "A group's status must be one of: %s."
msgstr "O estado de um grupo tem de ser um de: %s."

#: includes/premium/integrations/buddypress.php:1741
msgid "BuddyPress did not create the group and did not say why."
msgstr "O BuddyPress não criou o grupo e não disse porquê."

#: includes/premium/integrations/buddypress.php:1748
msgid "This group is public, so anybody can read it. Say that back to whoever asked."
msgstr "Este grupo é público, por isso qualquer pessoa o pode ler. Diga isso a quem pediu."

#: includes/premium/integrations/buddypress.php:1749
msgid "Created private, which is this integration's default when no status was given. set_group_privacy widens it."
msgstr "Criado como privado, que é a predefinição desta integração quando não é indicado estado. set_group_privacy alarga-o."

#: includes/premium/integrations/buddypress.php:1761
msgid "Updating a BuddyPress group"
msgstr "Atualizar um grupo do BuddyPress"

#: includes/premium/integrations/buddypress.php:1776
msgid "This version of BuddyPress does not expose a way to edit a group from here."
msgstr "Esta versão do BuddyPress não oferece forma de editar um grupo a partir daqui."

#: includes/premium/integrations/buddypress.php:1796
msgid "Give at least one of group_data.name, group_data.description or group_data.slug."
msgstr "Indique pelo menos um de group_data.name, group_data.description ou group_data.slug."

#: includes/premium/integrations/buddypress.php:1802
msgid "BuddyPress did not save the group and did not say why."
msgstr "O BuddyPress não guardou o grupo e não disse porquê."

#: includes/premium/integrations/buddypress.php:1810
msgid "The slug changed, so the group's old address no longer resolves. BuddyPress keeps the previous one as a redirect, but anything that hardcoded the old URL will need updating."
msgstr "O slug mudou, por isso o endereço antigo do grupo deixou de funcionar. O BuddyPress mantém o anterior como redirecionamento, mas tudo o que tinha o URL antigo escrito à mão vai precisar de ser atualizado."

#: includes/premium/integrations/buddypress.php:1823
msgid "Changing a BuddyPress group's privacy"
msgstr "Alterar a privacidade de um grupo do BuddyPress"

#: includes/premium/integrations/buddypress.php:1852
msgid "This version of BuddyPress does not expose a way to change a group's settings from here."
msgstr "Esta versão do BuddyPress não oferece forma de alterar as definições de um grupo a partir daqui."

#: includes/premium/integrations/buddypress.php:1865
msgid "BuddyPress did not change the group's privacy and did not say why."
msgstr "O BuddyPress não alterou a privacidade do grupo e não disse porquê."

#: includes/premium/integrations/buddypress.php:1871
msgid "This group was not public and now is. Everything already in it — every post, every file, every member's name — is readable by anybody, including visitors who are not logged in. Tell whoever asked."
msgstr "Este grupo não era público e agora é. Tudo o que já lá está — cada publicação, cada ficheiro, o nome de cada membro — pode ser lido por qualquer pessoa, incluindo visitantes sem sessão iniciada. Diga-o a quem pediu."

#: includes/premium/integrations/buddypress.php:1879
msgid "BuddyPress accepts every outstanding request to join when a private group becomes public, so the membership may have grown as a side effect of this change."
msgstr "O BuddyPress aceita todos os pedidos de adesão pendentes quando um grupo privado passa a público, por isso o número de membros pode ter crescido como efeito secundário desta alteração."

#: includes/premium/integrations/buddypress.php:1899
msgid "Deleting a BuddyPress group"
msgstr "Eliminar um grupo do BuddyPress"

#. translators: 1: group name, 2: group ID
#: includes/premium/integrations/buddypress.php:1922
#, php-format
msgid "Deleting \"%1$s\" (group %2$d) destroys its membership, its activity and its uploads, and cannot be undone. Pass confirm true to go ahead."
msgstr "Eliminar \"%1$s\" (grupo %2$d) destrói os seus membros, a sua atividade e os seus carregamentos, e não pode ser anulado. Passe confirm true para avançar."

#: includes/premium/integrations/buddypress.php:1931
msgid "This version of BuddyPress does not expose a way to delete a group from here."
msgstr "Esta versão do BuddyPress não oferece forma de eliminar um grupo a partir daqui."

#: includes/premium/integrations/buddypress.php:1937
msgid "BuddyPress did not delete the group and did not say why."
msgstr "O BuddyPress não eliminou o grupo e não disse porquê."

#: includes/premium/integrations/buddypress.php:1943
msgid "The group and everything in it are gone. There is no undo."
msgstr "O grupo e tudo o que nele estava desapareceram. Não há forma de anular."

#: includes/premium/integrations/buddypress.php:1955
msgid "Listing a BuddyPress group's members"
msgstr "Listar os membros de um grupo do BuddyPress"

#: includes/premium/integrations/buddypress.php:1970
msgid "This version of BuddyPress does not expose a group's membership where this integration can read it."
msgstr "Esta versão do BuddyPress não expõe os membros de um grupo num sítio onde esta integração os possa ler."

#: includes/premium/integrations/buddypress.php:2034
msgid "Adding a member to a BuddyPress group"
msgstr "Adicionar um membro a um grupo do BuddyPress"

#: includes/premium/integrations/buddypress.php:2049
msgid "This version of BuddyPress does not expose a way to add a member to a group from here."
msgstr "Esta versão do BuddyPress não oferece forma de adicionar um membro a um grupo a partir daqui."

#: includes/premium/integrations/buddypress.php:2064
msgid "BuddyPress did not add that member to the group and did not say why."
msgstr "O BuddyPress não adicionou esse membro ao grupo e não disse porquê."

#: includes/premium/integrations/buddypress.php:2071
msgid "This joins the member without asking them, and BuddyPress records it in the group's activity, so other members will see it."
msgstr "Isto junta o membro sem lhe perguntar, e o BuddyPress regista-o na atividade do grupo, por isso os outros membros vão vê-lo."

#: includes/premium/integrations/buddypress.php:2089
msgid "Removing a member from a BuddyPress group"
msgstr "Remover um membro de um grupo do BuddyPress"

#: includes/premium/integrations/buddypress.php:2104
msgid "This version of BuddyPress does not expose a way to remove a member from a group from here."
msgstr "Esta versão do BuddyPress não oferece forma de remover um membro de um grupo a partir daqui."

#: includes/premium/integrations/buddypress.php:2110
msgid "BuddyPress did not remove that member and did not say why — check they were a member to begin with."
msgstr "O BuddyPress não removeu esse membro e não disse porquê — verifique se era sequer membro."

#: includes/premium/integrations/buddypress.php:2117
msgid "The member loses access to the group. Anything they posted in it stays."
msgstr "O membro perde o acesso ao grupo. O que tiver publicado nele fica."

#: includes/premium/integrations/buddypress.php:2135
msgid "Changing a member's role in a BuddyPress group"
msgstr "Alterar o papel de um membro num grupo do BuddyPress"

#. translators: %s: list of valid group roles
#: includes/premium/integrations/buddypress.php:2156
#, php-format
msgid "role must be one of: %s."
msgstr "role tem de ser um de: %s."

#: includes/premium/integrations/buddypress.php:2164
msgid "That member is not in this group, so there is no role to change. add_group_member first."
msgstr "Esse membro não está neste grupo, por isso não há papel para alterar. Use primeiro add_group_member."

#: includes/premium/integrations/buddypress.php:2169
msgid "This version of BuddyPress does not expose a way to demote a group member from here."
msgstr "Esta versão do BuddyPress não oferece forma de despromover um membro de grupo a partir daqui."

#: includes/premium/integrations/buddypress.php:2175
msgid "This version of BuddyPress does not expose a way to promote a group member from here."
msgstr "Esta versão do BuddyPress não oferece forma de promover um membro de grupo a partir daqui."

#: includes/premium/integrations/buddypress.php:2184
msgid "BuddyPress did not change that member's role and did not say why."
msgstr "O BuddyPress não alterou o papel desse membro e não disse porquê."

#: includes/premium/integrations/buddypress.php:2193
msgid "An organiser can change the group's settings, remove other members and delete the group."
msgstr "Um organizador pode alterar as definições do grupo, remover outros membros e eliminar o grupo."

#: includes/premium/integrations/buddypress.php:2208
msgid "Reading the BuddyPress activity stream"
msgstr "Ler o fluxo de atividade do BuddyPress"

#: includes/premium/integrations/buddypress.php:2217
msgid "This version of BuddyPress does not expose its activity query where this integration can read it."
msgstr "Esta versão do BuddyPress não expõe a sua consulta de atividade num sítio onde esta integração a possa ler."

#: includes/premium/integrations/buddypress.php:2276
msgid "This is the public activity stream. Private messages are a different component and are not part of it."
msgstr "Este é o fluxo de atividade público. As mensagens privadas são outro componente e não fazem parte dele."

#: includes/premium/integrations/buddypress.php:2288
msgid "Reading a BuddyPress activity item"
msgstr "Ler um item de atividade do BuddyPress"

#: includes/premium/integrations/buddypress.php:2304
msgid "An activity item is something a member published. Changing or deleting it is visible to everybody who could see it."
msgstr "Um item de atividade é algo que um membro publicou. Alterá-lo ou eliminá-lo é visível para todos os que o podiam ver."

#: includes/premium/integrations/buddypress.php:2316
msgid "Posting to the BuddyPress activity stream"
msgstr "Publicar no fluxo de atividade do BuddyPress"

#: includes/premium/integrations/buddypress.php:2325
msgid "This version of BuddyPress does not expose a way to post activity from here."
msgstr "Esta versão do BuddyPress não oferece forma de publicar atividade a partir daqui."

#: includes/premium/integrations/buddypress.php:2332
msgid "Give what to post as activity_data.content."
msgstr "Indique o que publicar como activity_data.content."

#: includes/premium/integrations/buddypress.php:2343
msgid "Posting activity as another member"
msgstr "Publicar atividade como outro membro"

#: includes/premium/integrations/buddypress.php:2378
msgid "BuddyPress did not post the update and did not say why."
msgstr "O BuddyPress não publicou a atualização e não disse porquê."

#: includes/premium/integrations/buddypress.php:2384
msgid "This is now live in the community feed under that member's name, and anybody following the feed can see it. delete_activity removes it; hide_activity takes it out of the site-wide stream without destroying it."
msgstr "Isto está agora publicado no feed da comunidade com o nome desse membro, e qualquer pessoa que siga o feed o pode ver. delete_activity remove-o; hide_activity tira-o do fluxo de todo o site sem o destruir."

#: includes/premium/integrations/buddypress.php:2396
msgid "Deleting a BuddyPress activity item"
msgstr "Eliminar um item de atividade do BuddyPress"

#: includes/premium/integrations/buddypress.php:2415
msgid "Deleting another member's post"
msgstr "Eliminar a publicação de outro membro"

#. translators: %d: activity ID
#: includes/premium/integrations/buddypress.php:2424
#, php-format
msgid "Activity item %d is a post somebody made. Deleting it cannot be undone. Pass confirm true to go ahead, or use hide_activity, which is reversible."
msgstr "O item de atividade %d é uma publicação feita por alguém. Eliminá-lo não pode ser anulado. Passe confirm true para avançar, ou use hide_activity, que é reversível."

#: includes/premium/integrations/buddypress.php:2432
msgid "This version of BuddyPress does not expose a way to delete activity from here."
msgstr "Esta versão do BuddyPress não oferece forma de eliminar atividade a partir daqui."

#: includes/premium/integrations/buddypress.php:2438
msgid "BuddyPress did not delete the activity item and did not say why."
msgstr "O BuddyPress não eliminou o item de atividade e não disse porquê."

#: includes/premium/integrations/buddypress.php:2445
msgid "That post is gone from every stream that carried it. There is no undo."
msgstr "Essa publicação desapareceu de todos os fluxos que a mostravam. Não há forma de anular."

#: includes/premium/integrations/buddypress.php:2458
msgid "Hiding a BuddyPress activity item"
msgstr "Ocultar um item de atividade do BuddyPress"

#: includes/premium/integrations/buddypress.php:2459
msgid "Unhiding a BuddyPress activity item"
msgstr "Voltar a mostrar um item de atividade do BuddyPress"

#: includes/premium/integrations/buddypress.php:2476
msgid "This version of BuddyPress does not expose its activity model where this integration can change one."
msgstr "Esta versão do BuddyPress não expõe o seu modelo de atividade num sítio onde esta integração possa alterar um item."

#: includes/premium/integrations/buddypress.php:2500
msgid "BuddyPress did not save the activity item and did not say why."
msgstr "O BuddyPress não guardou o item de atividade e não disse porquê."

#: includes/premium/integrations/buddypress.php:2508
msgid "The item is out of the site-wide stream. It still exists, its author can still see it on their own profile, and unhide_activity puts it back."
msgstr "O item saiu do fluxo de todo o site. Continua a existir, o autor ainda o vê no seu próprio perfil, e unhide_activity volta a pô-lo."

#: includes/premium/integrations/buddypress.php:2509
msgid "The item is back in the site-wide stream, where everybody who follows the feed can see it again."
msgstr "O item voltou ao fluxo de todo o site, onde todos os que seguem o feed o podem ver novamente."

#: includes/premium/integrations/buddypress.php:2541
msgid "Counting BuddyPress friendships"
msgstr "Contar amizades do BuddyPress"

#: includes/premium/integrations/buddypress.php:2555
msgid "Counting one member's friendships"
msgstr "Contar as amizades de um membro"

#: includes/premium/integrations/buddypress.php:2589
msgid "Counts only. Who is friends with whom is a map of a real social group, and this integration does not hand one out."
msgstr "Só contagens. Quem é amigo de quem é um mapa de um grupo social real, e esta integração não o entrega."

#: includes/premium/integrations/buddypress.php:2606
msgid "Counting BuddyPress private messages"
msgstr "Contar mensagens privadas do BuddyPress"

#: includes/premium/integrations/buddypress.php:2624
msgid "BuddyPress's own message table names could not be resolved, so nothing was counted."
msgstr "Não foi possível determinar os nomes das tabelas de mensagens do próprio BuddyPress, por isso nada foi contado."

#: includes/premium/integrations/buddypress.php:2693
msgid "Counts and thread metadata only. The text of a private message, and its subject, are never returned by anything here, and no capability unlocks them. If somebody needs to read a thread, they are the wrong tool for it — the members involved are."
msgstr "Só contagens e metadados das conversas. O texto de uma mensagem privada, e o seu assunto, nunca são devolvidos por nada aqui, e nenhuma capacidade os desbloqueia. Se alguém precisa de ler uma conversa, esta não é a ferramenta certa — os membros envolvidos é que são."

#: includes/premium/integrations/edd.php:109
msgid "Easy Digital Downloads is not active on this site."
msgstr "O Easy Digital Downloads não está ativo neste site."

#: includes/premium/integrations/edd.php:117
msgid "Easy Digital Downloads is present but its order query layer is not loaded, so nothing here can answer reliably."
msgstr "O Easy Digital Downloads está presente, mas a sua camada de consulta de encomendas não está carregada, por isso nada aqui consegue responder de forma fiável."

#: includes/premium/integrations/edd.php:533
#: includes/premium/integrations/edd.php:542
msgid "(unnamed file)"
msgstr "(ficheiro sem nome)"

#: includes/premium/integrations/edd.php:568
msgid "File names only. A download URL is the product on a store like this one, so no URL, path or signed link is returned here by any action — a customer gets theirs from their purchase receipt."
msgstr "Só os nomes dos ficheiros. Numa loja como esta, um URL de transferência é o próprio produto, por isso nenhuma ação devolve aqui um URL, um caminho ou uma ligação assinada — um cliente recebe a sua a partir do recibo da compra."

#. translators: 1: the rejected status, 2: list of valid statuses
#: includes/premium/integrations/edd.php:710
#, php-format
msgid "\"%1$s\" is not an order status on this store. Valid statuses: %2$s."
msgstr "\"%1$s\" não é um estado de encomenda nesta loja. Estados válidos: %2$s."

#. translators: %d: the download ID that was asked for
#: includes/premium/integrations/edd.php:818
#, php-format
msgid "No download with ID %d exists on this store."
msgstr "Não existe nenhum download com o ID %d nesta loja."

#. translators: %d: the order ID that was asked for
#: includes/premium/integrations/edd.php:838
#, php-format
msgid "No order with ID %d exists on this store."
msgstr "Não existe nenhuma encomenda com o ID %d nesta loja."

#: includes/premium/integrations/edd.php:852
#: includes/premium/integrations/edd.php:1802
msgid "This version of Easy Digital Downloads does not expose its customers where this integration can read them."
msgstr "Esta versão do Easy Digital Downloads não expõe os seus clientes num sítio onde esta integração os possa ler."

#. translators: %d: the customer ID that was asked for
#: includes/premium/integrations/edd.php:862
#, php-format
msgid "No customer with ID %d exists on this store."
msgstr "Não existe nenhum cliente com o ID %d nesta loja."

#: includes/premium/integrations/edd.php:876
#: includes/premium/integrations/edd.php:1963
#: includes/premium/integrations/edd.php:2473
msgid "This version of Easy Digital Downloads does not expose its discounts where this integration can read them."
msgstr "Esta versão do Easy Digital Downloads não expõe os seus descontos num sítio onde esta integração os possa ler."

#. translators: %d: the discount ID that was asked for
#: includes/premium/integrations/edd.php:886
#, php-format
msgid "No discount with ID %d exists on this store."
msgstr "Não existe nenhum desconto com o ID %d nesta loja."

#: includes/premium/integrations/edd.php:943
msgid "Easy Digital Downloads – Store Management"
msgstr "Easy Digital Downloads – Gestão da loja"

#. translators: 1: action name, 2: list of valid actions
#: includes/premium/integrations/edd.php:1088
#, php-format
msgid "Unknown Easy Digital Downloads action \"%1$s\". Valid actions: %2$s."
msgstr "Ação do Easy Digital Downloads desconhecida \"%1$s\". Ações válidas: %2$s."

#. translators: 1: action name, 2: error message from the store
#: includes/premium/integrations/edd.php:1105
#, php-format
msgid "Easy Digital Downloads could not complete %1$s: %2$s"
msgstr "O Easy Digital Downloads não conseguiu concluir %1$s: %2$s"

#: includes/premium/integrations/edd.php:1167
msgid "Listing the store's downloads"
msgstr "Listar os downloads da loja"

#: includes/premium/integrations/edd.php:1205
msgid "One page of products. total counts what came back, not the whole catalogue — page through with page or offset. No file URLs are included."
msgstr "Uma página de produtos. total conta o que foi devolvido, não o catálogo inteiro — pagine com page ou offset. Não são incluídos URLs de ficheiros."

#: includes/premium/integrations/edd.php:1259
msgid "Reading a download"
msgstr "Ler um download"

#: includes/premium/integrations/edd.php:1266
#: includes/premium/integrations/edd.php:1366
#: includes/premium/integrations/edd.php:1427
msgid "Give the download as download_id."
msgstr "Indique o download como download_id."

#: includes/premium/integrations/edd.php:1289
#: includes/premium/integrations/edd.php:1292
msgid "Creating a download"
msgstr "Criar um download"

#: includes/premium/integrations/edd.php:1299
msgid "Give the product name as title."
msgstr "Indique o nome do produto como title."

#. translators: %s: error message from WordPress
#: includes/premium/integrations/edd.php:1322
#, php-format
msgid "WordPress refused to create the download: %s"
msgstr "O WordPress recusou criar o download: %s"

#: includes/premium/integrations/edd.php:1332
msgid "WordPress returned no ID for the new download."
msgstr "O WordPress não devolveu nenhum ID para o novo download."

#: includes/premium/integrations/edd.php:1344
msgid "Created as a draft with no files attached, so it is not sellable yet. Upload the file in wp-admin and publish it there once the delivery is right."
msgstr "Criado como rascunho sem ficheiros anexados, por isso ainda não pode ser vendido. Carregue o ficheiro no wp-admin e publique-o lá quando a entrega estiver correta."

#: includes/premium/integrations/edd.php:1356
#: includes/premium/integrations/edd.php:1359
msgid "Changing a download's price"
msgstr "Alterar o preço de um download"

#: includes/premium/integrations/edd.php:1370
msgid "Give the new price as price, a number."
msgstr "Indique o novo preço como price, um número."

#: includes/premium/integrations/edd.php:1376
msgid "A price cannot be negative."
msgstr "Um preço não pode ser negativo."

#: includes/premium/integrations/edd.php:1391
msgid "This download has price options, so its base price is not what a buyer pays. Edit the price options in wp-admin instead — changing the base price here would look like it worked and change nothing on the storefront."
msgstr "Este download tem opções de preço, por isso o preço base não é o que o comprador paga. Edite antes as opções de preço no wp-admin — alterar aqui o preço base pareceria ter funcionado e não mudaria nada na loja."

#: includes/premium/integrations/edd.php:1405
msgid "The new price applies to checkouts from now on. Orders already placed keep the price they were placed at."
msgstr "O novo preço aplica-se aos pagamentos a partir de agora. As encomendas já feitas mantêm o preço com que foram feitas."

#: includes/premium/integrations/edd.php:1417
#: includes/premium/integrations/edd.php:1420
msgid "Changing a download's status"
msgstr "Alterar o estado de um download"

#. translators: %s: list of valid statuses
#: includes/premium/integrations/edd.php:1441
#, php-format
msgid "Give the new status as status, one of: %s. Trashing a download is not offered here, because it breaks the purchase records that point at it."
msgstr "Indique o novo estado como status, um de: %s. Mover um download para o lixo não é oferecido aqui, porque estraga os registos de compra que apontam para ele."

#. translators: %s: error message from WordPress
#: includes/premium/integrations/edd.php:1465
#, php-format
msgid "WordPress refused to change the download's status: %s"
msgstr "O WordPress recusou alterar o estado do download: %s"

#: includes/premium/integrations/edd.php:1478
msgid "Published. Check it has a file attached before telling anyone about it — a published download with no file takes money and delivers nothing."
msgstr "Publicado. Verifique se tem um ficheiro anexado antes de o anunciar a alguém — um download publicado sem ficheiro recebe dinheiro e não entrega nada."

#: includes/premium/integrations/edd.php:1479
msgid "Status changed. Anyone holding a direct link to the product page will now see whatever that status shows them."
msgstr "Estado alterado. Quem tiver uma ligação direta para a página do produto vai agora ver o que esse estado lhe mostrar."

#: includes/premium/integrations/edd.php:1493
#: includes/premium/integrations/edd.php:1499
msgid "Listing orders"
msgstr "Listar encomendas"

#: includes/premium/integrations/edd.php:1549
msgid "Orders from the EDD 3.x order tables. Each row names a buyer by email; the payment key and the buyer's IP are not returned. Nothing here refunds or deletes an order."
msgstr "Encomendas das tabelas de encomendas do EDD 3.x. Cada linha identifica um comprador pelo email; a chave de pagamento e o IP do comprador não são devolvidos. Nada aqui reembolsa ou elimina uma encomenda."

#: includes/premium/integrations/edd.php:1561
#: includes/premium/integrations/edd.php:1568
msgid "Reading an order"
msgstr "Ler uma encomenda"

#: includes/premium/integrations/edd.php:1575
msgid "Give the order as payment_id."
msgstr "Indique a encomenda como payment_id."

#: includes/premium/integrations/edd.php:1607
msgid "The order and its lines. The payment key, the gateway's own transaction reference and the buyer's IP are withheld. Nothing here issues a refund."
msgstr "A encomenda e as suas linhas. A chave de pagamento, a referência da transação do próprio gateway e o IP do comprador são retidos. Nada aqui emite um reembolso."

#: includes/premium/integrations/edd.php:1657
msgid "Counting orders and revenue"
msgstr "Contar encomendas e receita"

#: includes/premium/integrations/edd.php:1698
msgid "Counts and sums only, so no buyer is named. revenue covers completed and partially refunded orders, which is the money the store kept."
msgstr "Só contagens e somas, por isso nenhum comprador é identificado. revenue abrange encomendas concluídas e parcialmente reembolsadas, que é o dinheiro que a loja ficou."

#: includes/premium/integrations/edd.php:1713
msgid "Reading the refund position"
msgstr "Ler a situação dos reembolsos"

#: includes/premium/integrations/edd.php:1721
msgid "Reading one order's refund position"
msgstr "Ler a situação de reembolso de uma encomenda"

#: includes/premium/integrations/edd.php:1742
msgid "Read-only. This hub cannot issue or reverse a refund, by design — do it on the order screen in wp-admin, where the amount and the gateway are in front of you."
msgstr "Só de leitura. Este hub não consegue emitir nem reverter um reembolso, por definição — faça-o no ecrã da encomenda no wp-admin, onde tem o valor e o gateway à sua frente."

#: includes/premium/integrations/edd.php:1780
msgid "Read-only. Nothing in this integration issues a refund or deletes an order; that stays on the order screen in wp-admin."
msgstr "Só de leitura. Nada nesta integração emite um reembolso ou elimina uma encomenda; isso fica no ecrã da encomenda no wp-admin."

#: includes/premium/integrations/edd.php:1794
#: includes/premium/integrations/edd.php:1797
msgid "Searching customers"
msgstr "Pesquisar clientes"

#: includes/premium/integrations/edd.php:1836
msgid "Highest lifetime value first. These are real people: say only as much about them as the question needs. No saved card, token or gateway customer reference is returned."
msgstr "Maior valor vitalício primeiro. São pessoas reais: diga sobre elas apenas o que a pergunta precisar. Nenhum cartão guardado, token ou referência de cliente do gateway é devolvido."

#: includes/premium/integrations/edd.php:1848
#: includes/premium/integrations/edd.php:1851
msgid "Reading a customer"
msgstr "Ler um cliente"

#: includes/premium/integrations/edd.php:1858
msgid "Give the customer as customer_id. It is the EDD customer ID, not a WordPress user ID."
msgstr "Indique o cliente como customer_id. É o ID de cliente do EDD, não um ID de utilizador do WordPress."

#: includes/premium/integrations/edd.php:1878
msgid "Lifetime value is the purchase_value the customers table keeps, which EDD maintains as orders complete and refund. Saved cards, gateway customer references and any EDD API keys this person holds are never returned."
msgstr "O valor vitalício é o purchase_value que a tabela de clientes guarda, que o EDD mantém à medida que as encomendas são concluídas e reembolsadas. Os cartões guardados, as referências de cliente do gateway e quaisquer chaves de API do EDD que esta pessoa tenha nunca são devolvidos."

#: includes/premium/integrations/edd.php:1890
#: includes/premium/integrations/edd.php:1893
msgid "Listing a customer's orders"
msgstr "Listar as encomendas de um cliente"

#: includes/premium/integrations/edd.php:1900
msgid "Give the customer as customer_id."
msgstr "Indique o cliente como customer_id."

#: includes/premium/integrations/edd.php:1944
msgid "One page of this customer's orders. spent_on_this_page covers only the rows returned — read lifetime_value from get_customer for the whole relationship."
msgstr "Uma página das encomendas deste cliente. spent_on_this_page abrange apenas as linhas devolvidas — leia lifetime_value de get_customer para a relação completa."

#: includes/premium/integrations/edd.php:1958
msgid "Listing discount codes"
msgstr "Listar códigos de desconto"

#: includes/premium/integrations/edd.php:2001
msgid "Discount codes as the store holds them. A code with status active but an end_date in the past still refuses at checkout — expired_discounts_still_active finds those."
msgstr "Os códigos de desconto tal como a loja os guarda. Um código com estado ativo mas com end_date no passado continua a ser recusado no pagamento — expired_discounts_still_active encontra esses."

#: includes/premium/integrations/edd.php:2013
msgid "Reading a discount code"
msgstr "Ler um código de desconto"

#: includes/premium/integrations/edd.php:2020
#: includes/premium/integrations/edd.php:2184
msgid "Give the discount as discount_id."
msgstr "Indique o desconto como discount_id."

#: includes/premium/integrations/edd.php:2042
msgid "would_apply_now is the useful field: a code can be active, unexpired and still refuse because it has been used up."
msgstr "would_apply_now é o campo útil: um código pode estar ativo, não expirado e mesmo assim ser recusado por já ter sido esgotado."

#: includes/premium/integrations/edd.php:2057
#: includes/premium/integrations/edd.php:2060
msgid "Creating a discount code"
msgstr "Criar um código de desconto"

#: includes/premium/integrations/edd.php:2065
msgid "This version of Easy Digital Downloads does not expose a way to create a discount from here."
msgstr "Esta versão do Easy Digital Downloads não oferece forma de criar um desconto a partir daqui."

#: includes/premium/integrations/edd.php:2071
msgid "Give the code a buyer types as code."
msgstr "Indique como code o código que o comprador escreve."

#. translators: %s: the discount code
#: includes/premium/integrations/edd.php:2082
#, php-format
msgid "The code \"%s\" already exists on this store. Codes are not unique by accident — reusing one would change the terms of a code that may already be published somewhere."
msgstr "O código \"%s\" já existe nesta loja. Os códigos não são únicos por acaso — reutilizar um alteraria as condições de um código que pode já estar publicado algures."

#: includes/premium/integrations/edd.php:2091
msgid "Give the discount amount as amount, a number."
msgstr "Indique o valor do desconto como amount, um número."

#: includes/premium/integrations/edd.php:2097
msgid "A discount amount has to be greater than zero."
msgstr "O valor de um desconto tem de ser maior do que zero."

#: includes/premium/integrations/edd.php:2105
msgid "amount_type must be percent or flat."
msgstr "amount_type tem de ser percent ou flat."

#: includes/premium/integrations/edd.php:2109
msgid "A percentage discount over 100 would pay the buyer. Give amount as a number up to 100, or use amount_type flat."
msgstr "Um desconto percentual acima de 100 pagaria ao comprador. Indique amount como um número até 100, ou use amount_type flat."

#: includes/premium/integrations/edd.php:2133
msgid "end_date has to be a date this store can read, such as 2026-12-31 23:59:59."
msgstr "end_date tem de ser uma data que esta loja consiga ler, como 2026-12-31 23:59:59."

#: includes/premium/integrations/edd.php:2143
msgid "Easy Digital Downloads did not create the discount and gave no reason."
msgstr "O Easy Digital Downloads não criou o desconto e não deu nenhum motivo."

#: includes/premium/integrations/edd.php:2154
msgid "The code is live now. Say the code and the amount back to whoever asked, so a wrong number is caught before a buyer finds it."
msgstr "O código já está ativo. Confirme o código e o valor a quem pediu, para que um número errado seja apanhado antes de um comprador o encontrar."

#: includes/premium/integrations/edd.php:2155
msgid "Created switched off, which is the default: a live code is a standing instruction to take less money, and a wrong amount only shows up after somebody has used it. Activate it in wp-admin once the terms read right."
msgstr "Criado desligado, que é a predefinição: um código ativo é uma instrução permanente para receber menos dinheiro, e um valor errado só se nota depois de alguém o usar. Ative-o no wp-admin quando as condições estiverem certas."

#: includes/premium/integrations/edd.php:2170
#: includes/premium/integrations/edd.php:2173
msgid "Deactivating a discount code"
msgstr "Desativar um código de desconto"

#: includes/premium/integrations/edd.php:2178
msgid "This version of Easy Digital Downloads does not expose a way to change a discount's status from here."
msgstr "Esta versão do Easy Digital Downloads não oferece forma de alterar o estado de um desconto a partir daqui."

#: includes/premium/integrations/edd.php:2203
msgid "Switched off, not deleted — the orders that used this code keep the record of what it discounted. Anywhere the code is still advertised will now refuse it at checkout, so it is worth taking it down too."
msgstr "Desligado, não eliminado — as encomendas que usaram este código mantêm o registo do que foi descontado. Onde quer que o código ainda esteja anunciado, vai agora ser recusado no pagamento, por isso vale a pena retirá-lo também."

#: includes/premium/integrations/edd.php:2217
msgid "Reading the store statistics"
msgstr "Ler as estatísticas da loja"

#: includes/premium/integrations/edd.php:2243
msgid "Orders on this store live in Easy Digital Downloads' own tables, not the posts table, which is why the period figures are aggregated rather than counted from posts. The per-day helper EDD used to offer for this is deprecated in 3.x."
msgstr "As encomendas desta loja vivem nas tabelas do próprio Easy Digital Downloads, não na tabela de artigos, e é por isso que os valores do período são agregados em vez de contados a partir dos artigos. A função por dia que o EDD oferecia para isto está obsoleta na versão 3.x."

#: includes/premium/integrations/edd.php:2255
msgid "Reading the revenue report"
msgstr "Ler o relatório de receita"

#: includes/premium/integrations/edd.php:2293
msgid "The two windows are the same length, back to back. Both count completed and partially refunded orders."
msgstr "Os dois períodos têm a mesma duração e são consecutivos. Ambos contam encomendas concluídas e parcialmente reembolsadas."

#: includes/premium/integrations/edd.php:2294
msgid "The previous window took no money, so there is no percentage to compare against — the change is left out rather than reported as a growth figure off zero."
msgstr "O período anterior não teve receita, por isso não há percentagem com que comparar — a variação fica de fora em vez de ser apresentada como um crescimento a partir de zero."

#: includes/premium/integrations/edd.php:2306
msgid "Reading the best-selling downloads"
msgstr "Ler os downloads mais vendidos"

#: includes/premium/integrations/edd.php:2321
msgid "Reading earnings by product"
msgstr "Ler a receita por produto"

#: includes/premium/integrations/edd.php:2388
msgid "Rolled up from the order lines, so a product renamed since a sale appears under the name it was sold as. No file URLs are included."
msgstr "Agregado a partir das linhas das encomendas, por isso um produto que mudou de nome desde uma venda aparece com o nome com que foi vendido. Não são incluídos URLs de ficheiros."

#: includes/premium/integrations/edd.php:2402
msgid "Auditing downloads for missing files"
msgstr "Auditar downloads sem ficheiros"

#: includes/premium/integrations/edd.php:2455
msgid "Every published download in the page scanned has at least one file attached. Bundles are skipped, because a bundle delivers the files of the products inside it."
msgstr "Todos os downloads publicados na página analisada têm pelo menos um ficheiro anexado. Os pacotes são saltados, porque um pacote entrega os ficheiros dos produtos que contém."

#: includes/premium/integrations/edd.php:2456
msgid "Each of these is live and takes money, and a buyer gets nothing for it. Fix the worst by sales count first. Bundles are skipped, because a bundle has no files of its own."
msgstr "Cada um destes está publicado e recebe dinheiro, e o comprador não recebe nada em troca. Corrija primeiro os piores, por número de vendas. Os pacotes são saltados, porque um pacote não tem ficheiros próprios."

#: includes/premium/integrations/edd.php:2468
msgid "Auditing discount codes"
msgstr "Auditar códigos de desconto"

#: includes/premium/integrations/edd.php:2516
msgid "The end date has passed, but the code is still switched on."
msgstr "A data de fim já passou, mas o código continua ligado."

#: includes/premium/integrations/edd.php:2517
msgid "Every permitted use has been taken, but the code is still switched on."
msgstr "Todas as utilizações permitidas já foram usadas, mas o código continua ligado."

#: includes/premium/integrations/edd.php:2527
msgid "No active code is past its date or used up in the page scanned."
msgstr "Nenhum código ativo está fora de prazo ou esgotado na página analisada."

#: includes/premium/integrations/edd.php:2528
msgid "Each of these looks live in wp-admin and refuses at checkout. If any is still printed in an email or on a page, that is a buyer being told a price the store will not honour. deactivate_discount switches one off; it does not take down wherever it is advertised."
msgstr "Cada um destes parece ativo no wp-admin e é recusado no pagamento. Se algum ainda estiver impresso num email ou numa página, é um comprador a ouvir um preço que a loja não vai cumprir. deactivate_discount desliga um; não o retira de onde estiver anunciado."

#: includes/premium/integrations/edd.php:2540
msgid "Auditing stalled orders"
msgstr "Auditar encomendas paradas"

#: includes/premium/integrations/edd.php:2597
msgid "Nothing has been sitting unfinished that long."
msgstr "Nada está por concluir há tanto tempo."

#: includes/premium/integrations/edd.php:2598
msgid "An order stuck pending usually means the gateway never called back, which can mean money taken and nothing delivered. Counts only — use list_payments with status pending to see which, and settle each one on the order screen."
msgstr "Uma encomenda presa em pendente normalmente significa que o gateway nunca respondeu, o que pode significar dinheiro recebido e nada entregue. Só contagens — use list_payments com status pending para ver quais, e resolva cada uma no ecrã da encomenda."

#: includes/premium/integrations/edd.php:2610
msgid "Auditing the store"
msgstr "Auditar a loja"

