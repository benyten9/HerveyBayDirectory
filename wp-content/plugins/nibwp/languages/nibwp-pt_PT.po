msgstr "O Themify Builder não conseguiu concluir %1$s: %2$s"

#. translators: 1: row index, 2: element id, 3: column count, 4: condition note
#: includes/premium/integrations/themify.php:1781
#, php-format
msgid "Row %1$d (%2$s): %3$d column(s)%4$s"
msgstr "Linha %1$d (%2$s): %3$d coluna(s)%4$s"

#. translators: 1: column index, 2: grid class, 3: module count
