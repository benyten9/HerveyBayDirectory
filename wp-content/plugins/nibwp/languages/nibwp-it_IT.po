msgstr "Il tuo account non può spostarlo nel cestino."

#: includes/studio/studio-builder.php:599
msgid "The trash is turned off on this site, so this would delete it for good. Delete it from wp-admin if that is what you want."
msgstr "Il cestino è disattivato su questo sito, quindi verrebbe eliminato definitivamente. Se è quello che vuoi, eliminalo da wp-admin."

#: includes/studio/studio-builder.php:602
msgid "Could not move it to the trash."
msgstr "Impossibile spostarlo nel cestino."

#: includes/studio/studio-builder.php:608
#: includes/studio/studio-builder.php:714
msgid "Nothing to do."
msgstr "Niente da fare."

#: includes/studio/studio-builder.php:646
#: includes/studio/studio-builder.php:651
msgid "That picture could not be kept."
msgstr "Impossibile conservare quell'immagine."

#: includes/studio/studio-builder.php:697
msgid "That template is not there any more."
msgstr "Quel template non c'è più."

#: includes/studio/studio-builder.php:703
#: includes/studio/studio-builder.php:730
msgid "Give the template a name."
msgstr "Dai un nome al template."

#: includes/studio/studio-builder.php:734
msgid "no content type yet: it is picked per page"
msgstr "ancora nessun tipo di contenuto: si sceglie pagina per pagina"

#. translators: 1: template name, 2: what it is used for
#: includes/studio/studio-builder.php:736
#, php-format
msgid "Create a new template named “%1$s” for %2$s, in the way this theme and its page builder make templates. Start from the site’s header and footer with the content in between, then tell me how to open it."
msgstr "Crea un nuovo template chiamato “%1$s” per %2$s, nel modo in cui questo tema e il suo page builder creano i template. Parti dall'header e dal footer del sito con il contenuto in mezzo, poi dimmi come aprirlo."

#: includes/studio/studio-builder.php:766
#, php-format
msgid "%s already have their own template: open it from the list to change it."
msgstr "%s hanno già un loro template: aprilo dall'elenco per modificarlo."

#: includes/studio/studio-builder.php:766
msgid "A template with that name exists already."
msgstr "Esiste già un template con quel nome."

#. translators: 1: template name, 2: content types it was made for, 3: those that kept their own
#: includes/studio/studio-builder.php:772
#, php-format
msgid "“%1$s” made for %2$s."
msgstr "“%1$s” creato per %2$s."

#. translators: 1: template name, 2: content types it was made for, 3: those that kept their own
#: includes/studio/studio-builder.php:772
#, php-format
msgid "%s kept their own template."
msgstr "%s hanno mantenuto il loro template."

#: includes/studio/studio-builder.php:817
msgid "A component needs a name and some HTML, under 60 KB."
msgstr "Un componente ha bisogno di un nome e di un po' di HTML, sotto i 60 KB."

#. translators: %d: how many components are saved
#: includes/studio/studio-builder.php:828
#, php-format
msgid "You have %d saved components, as many as there is room for. Delete one you no longer need, then save again."
msgstr "Hai %d componenti salvati, il massimo che c'è spazio per tenere. Eliminane uno che non ti serve più, poi salva di nuovo."

