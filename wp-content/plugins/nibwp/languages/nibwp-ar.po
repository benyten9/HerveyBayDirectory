msgid "Reading the site-wide ThirstyAffiliates state needs manage_options."
msgstr "قراءة حالة ThirstyAffiliates على مستوى الموقع تحتاج manage_options."

#. translators: %s: the action that was requested.
#: includes/premium/integrations/thirstyaffiliates.php:626
#, php-format
