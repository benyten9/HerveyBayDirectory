msgstr "إجراء غير معروف. استخدم get أو update_global أو update_post_type أو set_module."

#: includes/premium/integrations/rankmath.php:1451
msgid "robots_global must be an array of directives."
msgstr "يجب أن تكون قيمة robots_global مصفوفة من التوجيهات."

