msgstr "مرّر عنوان الكتلة بالضبط في \"confirm\" لحذفها: %s"

#: includes/premium/integrations/blocksy.php:2639
msgid "An \"extension\" slug is required. Run list_extensions for the slugs."
msgstr "الاسم المختصر \"extension\" مطلوب. شغّل list_extensions لمعرفة الأسماء المختصرة."

#. translators: %s: the extension slug given
#: includes/premium/integrations/blocksy.php:2649
#, php-format
msgid "No Blocksy Companion extension is called \"%s\". Run list_extensions for the slugs this build knows."
msgstr "لا يوجد امتداد Blocksy Companion باسم \"%s\". شغّل list_extensions لمعرفة الأسماء المختصرة التي يعرفها هذا الإصدار."

#: includes/premium/integrations/blocksy.php:2657
msgid "Pass \"enabled\" true or false."
msgstr "مرّر \"enabled\" بقيمة true أو false."

