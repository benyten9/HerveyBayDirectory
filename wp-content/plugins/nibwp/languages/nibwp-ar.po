msgstr "لم تُقدَّم أي حقول SEO، لذا لم يُكتب شيء."

#: includes/premium/integrations/rankmath.php:1144
#: includes/premium/integrations/rankmath.php:1283
msgid "Unknown action. Use get or set."
msgstr "إجراء غير معروف. استخدم get أو set."

#: includes/premium/integrations/rankmath.php:1152
msgid "Rank Math — Bulk SEO"
msgstr "Rank Math — SEO بالجملة"

#: includes/premium/integrations/rankmath.php:1292
msgid "A bulk write overwrites the SEO overrides on every match and cannot be undone. Run action=get with the same filters, then re-issue with confirm set to true."
msgstr "الكتابة بالجملة تستبدل تجاوزات SEO في كل نتيجة مطابقة ولا يمكن التراجع عنها. شغّل action=get بعوامل التصفية نفسها، ثم أعد الاستدعاء مع تعيين confirm إلى true."

#: includes/premium/integrations/rankmath.php:1298
msgid "Provide a non-empty \"fields\" object for set."
msgstr "قدّم كائن \"fields\" غير فارغ لإجراء set."

#: includes/premium/integrations/rankmath.php:1342
