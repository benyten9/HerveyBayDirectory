msgstr "%d idiomas de destino. Cada palavra do site é traduzida uma vez por idioma, então o uso cresce com o site, não só com a quantidade de idiomas."

#: includes/premium/integrations/weglot.php:1027
msgid "Weglot — Translation workflow"
msgstr "Weglot — Fluxo de trabalho de tradução"

