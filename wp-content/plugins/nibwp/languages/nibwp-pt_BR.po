#: includes/helpers.php:1309
#: includes/integrations/paper/paper-page.php:334
#: includes/integrations/paper/paper-page.php:365
#: includes/user-access.php:267
#: nibwp.php:992
#: nibwp.php:993
msgid "Paper.design"
msgstr "Paper.design"

#: includes/helpers.php:2564
msgid "paper.design → WordPress"
msgstr "paper.design → WordPress"

#: includes/helpers.php:2565
msgid "Your agent reads the design out of Paper and hands it here. This site never fetches from Paper — it cannot."
msgstr "Seu agente lê o design no Paper e o entrega aqui. Este site nunca busca nada no Paper — ele não consegue."

#: includes/helpers.php:2567
#: includes/integrations/paper/paper-page.php:495
msgid "Open the Paper desktop app"
msgstr "Abra o aplicativo de desktop do Paper"

#: includes/helpers.php:2567
msgid "The app is what starts Paper's MCP server. Nothing else does, and nothing works until it is running."
msgstr "É o aplicativo que inicia o servidor MCP do Paper. Nada mais faz isso, e nada funciona até ele estar rodando."

#: includes/helpers.php:2568
#: includes/integrations/paper/paper-page.php:506
msgid "Add Paper to your agent"
msgstr "Adicione o Paper ao seu agente"

#: includes/helpers.php:2568
msgid "One command, copied from the Connect tab, run on the machine your agent runs on. There is no API key and no token — Paper does not issue one."
msgstr "Um comando, copiado da aba Conectar, executado na máquina onde seu agente roda. Não há chave de API nem token — o Paper não emite nenhum."

#: includes/helpers.php:2569
#: includes/integrations/paper/paper-page.php:517
msgid "Ask the agent to pair"
msgstr "Peça ao agente para parear"

#: includes/helpers.php:2569
msgid "The Connect tab has the prompt. The agent checks its Paper connection and reports back, which is the only direction this check can run: your laptop can see Paper, this site cannot."
msgstr "A aba Conectar tem o prompt. O agente verifica a conexão dele com o Paper e informa o resultado, que é a única direção em que essa verificação pode acontecer: seu computador enxerga o Paper, este site não."

#: includes/helpers.php:2570
msgid "Hand a frame over"
msgstr "Entregue um frame"

#: includes/helpers.php:2570
msgid "Select the frame in Paper and ask for it. The agent reads it and sends it to ingest, where it becomes a library entry with its colours, fonts and warnings."
msgstr "Selecione o frame no Paper e peça por ele. O agente o lê e envia para a importação, onde ele vira uma entrada da biblioteca com suas cores, fontes e avisos."

#: includes/helpers.php:2571
msgid "Plan, then convert"
msgstr "Planeje e depois converta"

#: includes/helpers.php:2571
msgid "paper-pro plans the build — which builder, what repeats, which colours already exist as tokens here — and convert writes a draft. Nothing is published."
msgstr "O paper-pro planeja a construção — qual builder, o que se repete, quais cores já existem como tokens aqui — e a conversão grava um rascunho. Nada é publicado."

#: includes/helpers.php:2577
#: includes/integrations/paper/paper-page.php:1022
msgid "Paper's MCP documentation"
msgstr "Documentação do MCP do Paper"

#. translators: Workflow when to use: save-to-etchedy-library
#: includes/i18n-data-strings.php:27
msgid "A component was built and the user wants to keep it: \"save this hero to my Etchedy library\"."
msgstr "Um componente foi construído e o usuário quer guardá-lo: \"salve este hero na minha biblioteca do Etchedy\"."

#. translators: Skill feature: paper-pro
#: includes/i18n-data-strings.php:31
msgid "A design open in Paper becomes a native page in your site's own builder"
msgstr "Um design aberto no Paper vira uma página nativa no builder do seu próprio site"

#. translators: Skill feature: builderius-pro
#: includes/i18n-data-strings.php:35
msgid "A mistyped setting names the module it was put on, and the modules that do accept it"
msgstr "Uma configuração digitada errado informa o módulo em que foi colocada e os módulos que a aceitam"

#. translators: Workflow when to use: save-to-bricksed-library
#: includes/i18n-data-strings.php:37
msgid "A section was built in Bricks and the user wants to keep it: \"save this hero to my Bricksed library\"."
msgstr "Uma seção foi construída no Bricks e o usuário quer guardá-la: \"salve este hero na minha biblioteca do Bricksed\"."

#. translators: Skill feature: bricksed-pro
#: includes/i18n-data-strings.php:43
msgid "ACSS tokens with fallbacks and BEM brand prefixes enforced on every save"
msgstr "Tokens do ACSS com valores de reserva e prefixos BEM da marca exigidos em cada salvamento"

#. translators: Skill feature: etchedy-pro
#: includes/i18n-data-strings.php:45
msgid "ACSS tokens with fallbacks enforced on every save"
msgstr "Tokens do ACSS com valores de reserva exigidos em cada salvamento"

#. translators: Skill feature: mosaic-pro
#: includes/i18n-data-strings.php:49
msgid "Accordion, tabs and navbar built from Mosaic's own default structure"
msgstr "Acordeão, abas e barra de navegação construídos a partir da estrutura padrão do próprio Mosaic"

#. translators: Workflow summary: build-page-from-bricksed-library
#: includes/i18n-data-strings.php:57
msgid "Assemble a Bricks page section by section from stored Bricksed components, with per-page content; build and save anything the library is missing so the next page can reuse it."
msgstr "Monte uma página do Bricks seção por seção a partir de componentes guardados no Bricksed, com conteúdo próprio de cada página; construa e salve o que faltar na biblioteca para que a próxima página possa reutilizar."

#. translators: Workflow summary: build-page-from-etchedy-library
#: includes/i18n-data-strings.php:59
msgid "Assemble a page section by section from stored Etchedy components, with per-page content; build and save anything the library is missing so the next page can reuse it."
msgstr "Monte uma página seção por seção a partir de componentes guardados no Etchedy, com conteúdo próprio de cada página; construa e salve o que faltar na biblioteca para que a próxima página possa reutilizar."

#. translators: Workflow title: audit-bricksed-library
#: includes/i18n-data-strings.php:69
