msgstr "Indique o widget com widget_id, ou com row, cell e index."

#. translators: 1: widget index, 2: row index, 3: cell index
#: includes/premium/integrations/siteorigin.php:1105
#, php-format
msgid "There is no widget %1$d in row %2$d cell %3$d."
msgstr "Não existe o widget %1$d na linha %2$d, célula %3$d."

#: includes/premium/integrations/siteorigin.php:1223
msgid "The settings must be given as an object."
msgstr "As configurações precisam ser informadas como um objeto."

#: includes/premium/integrations/siteorigin.php:1239
msgid "Listing the available widget types"
msgstr "Listando os tipos de widget disponíveis"

#: includes/premium/integrations/siteorigin.php:1367
msgid "Give the settings to write."
msgstr "Informe as configurações a gravar."

#: includes/premium/integrations/siteorigin.php:1412
msgid "A widget_class is required."
msgstr "Um widget_class é obrigatório."

#. translators: %s: widget class name
#: includes/premium/integrations/siteorigin.php:1420
#, php-format
msgid "No widget class \"%s\" is registered on this site, so it would render nothing. list_widget_types reports what is available."
msgstr "Nenhuma classe de widget \"%s\" está registrada neste site, então ela não renderizaria nada. list_widget_types informa o que está disponível."

#. translators: 1: row index, 2: cell index
#: includes/premium/integrations/siteorigin.php:1434
#: includes/premium/integrations/siteorigin.php:1584
#, php-format
msgid "Row %1$d cell %2$d is not in this layout."
msgstr "A linha %1$d, célula %2$d, não está neste layout."

#: includes/premium/integrations/siteorigin.php:1662
msgid "Every cell weight must be a number."
msgstr "Cada peso de célula precisa ser um número."

#: includes/premium/integrations/siteorigin.php:1668
msgid "Every cell weight must be greater than zero."
msgstr "Cada peso de célula precisa ser maior que zero."

#: includes/premium/integrations/siteorigin.php:1676
msgid "Give at least one cell weight."
msgstr "Informe pelo menos um peso de célula."

#: includes/premium/integrations/siteorigin.php:1847
#: includes/premium/integrations/siteorigin.php:2122
msgid "A row has between 1 and 12 cells."
msgstr "Uma linha tem entre 1 e 12 células."

#: includes/premium/integrations/siteorigin.php:1852
#: includes/premium/integrations/siteorigin.php:2102
msgid "The weights must be given as a list of numbers."
msgstr "Os pesos precisam ser informados como uma lista de números."

#: includes/premium/integrations/siteorigin.php:1862
#: includes/premium/integrations/siteorigin.php:2114
msgid "Give one weight per cell."
msgstr "Informe um peso por célula."

#. translators: %d: row index
#: includes/premium/integrations/siteorigin.php:1931
#: includes/premium/integrations/siteorigin.php:2090
#: includes/premium/integrations/siteorigin.php:2225
#, php-format
msgid "Row %d is not in this layout."
msgstr "A linha %d não está neste layout."

#. translators: 1: row index, 2: number of widgets
#: includes/premium/integrations/siteorigin.php:1960
#, php-format
msgid "Row %1$d still holds %2$d widget(s). Move them with move_widget or delete them with remove_widget first — removing the row would take them with it."
msgstr "A linha %1$d ainda tem %2$d widget(s). Mova-os com move_widget ou exclua-os com remove_widget primeiro — remover a linha os levaria junto."

#: includes/premium/integrations/siteorigin.php:2010
msgid "Give the order as a list of the current row indexes."
msgstr "Informe a ordem como uma lista dos índices atuais das linhas."

#: includes/premium/integrations/siteorigin.php:2017
msgid "Every entry in the order must be a row index."
msgstr "Cada item da ordem precisa ser um índice de linha."

#. translators: %d: number of rows
#: includes/premium/integrations/siteorigin.php:2034
#, php-format
msgid "The order must list each of the %d row indexes exactly once."
msgstr "A ordem precisa listar cada um dos %d índices de linha exatamente uma vez."

#: includes/premium/integrations/siteorigin.php:2233
msgid "Give the weights as a list of numbers, one per cell."
msgstr "Informe os pesos como uma lista de números, um por célula."

#. translators: 1: number of weights given, 2: number of cells in the row
#: includes/premium/integrations/siteorigin.php:2249
#, php-format
msgid "%1$d weights were given for a row of %2$d cells. Use set_row_cells to change how many cells the row has."
msgstr "Foram informados %1$d pesos para uma linha de %2$d células. Use set_row_cells para mudar quantas células a linha tem."

#: includes/premium/integrations/siteorigin.php:2373
msgid "Reading the Page Builder settings"
msgstr "Lendo as configurações do Page Builder"

#: includes/premium/integrations/siteorigin.php:2415
msgid "Values are reported for an allow-listed set of layout and behaviour switches. Everything else is reported as a name and whether it is set."
msgstr "Os valores são informados para um conjunto permitido de chaves de layout e comportamento. Todo o resto é informado pelo nome e se está definido."

#: includes/premium/integrations/siteorigin.php:2427
msgid "Changing the Page Builder settings"
msgstr "Alterando as configurações do Page Builder"

#: includes/premium/integrations/siteorigin.php:2438
msgid "Give the settings to change in settings_update."
msgstr "Informe as configurações a alterar em settings_update."

#. translators: %s: comma-separated list of setting names
#: includes/premium/integrations/siteorigin.php:2501
#, php-format
msgid "None of those settings can be written here: %s. get_settings lists the ones that can."
msgstr "Nenhuma dessas configurações pode ser gravada aqui: %s. get_settings lista as que podem."

#: includes/premium/integrations/siteorigin.php:2519
msgid "Reading the widget bundle status"
msgstr "Lendo o status do pacote de widgets"

#: includes/premium/integrations/siteorigin.php:2573
msgid "Listing the reusable layouts"
msgstr "Listando os layouts reutilizáveis"

#: includes/premium/integrations/siteorigin.php:2613
msgid "Reading a reusable layout"
msgstr "Lendo um layout reutilizável"

#: includes/premium/integrations/siteorigin.php:2620
