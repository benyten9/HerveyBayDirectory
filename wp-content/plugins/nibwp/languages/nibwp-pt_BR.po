msgid "The server is busy. Trying again (%1$d of %2$d)…"
msgstr "O servidor está ocupado. Tentando de novo (%1$d de %2$d)…"

#: assets/js/studio-export.js:692
msgid "The connection to your site dropped."
msgstr "A conexão com seu site caiu."

#: assets/js/studio-export.js:693
msgid "Your login ran out. Reload the page and try again."
msgstr "Seu login expirou. Recarregue a página e tente de novo."

#: assets/js/studio-export.js:694
msgid "A firewall or security plugin blocked the request."
msgstr "Um firewall ou plugin de segurança bloqueou a solicitação."

#: assets/js/studio-export.js:695
msgid "The server hit an error, often memory or a plugin. The system check can tell more."
msgstr "O servidor teve um erro, muitas vezes memória ou um plugin. A verificação do sistema pode dizer mais."

#: assets/js/studio-export.js:696
msgid "The server took too long to answer: a host time limit stopped it."
msgstr "O servidor demorou demais para responder: um limite de tempo da hospedagem o parou."

#: assets/js/studio-export.js:711
msgid "What is done is kept: Try again goes on from where it stopped."
msgstr "O que foi feito fica guardado: Tentar de novo continua de onde parou."

#: assets/js/studio-export.js:713
msgid "Run the system check"
msgstr "Fazer a verificação do sistema"

#: assets/js/studio-export.js:714
msgid "Start over"
msgstr "Começar de novo"

