#: assets/js/studio-builder-sketch.js:125
#: assets/js/studio-builder.js:234
msgid "Hero"
msgstr "Hero"

#: assets/js/studio-builder-sketch.js:126
msgid "The first thing visitors see"
msgstr "Het eerste wat bezoekers zien"

#: assets/js/studio-builder-sketch.js:128
msgid "The promise, in under 8 words"
msgstr "De belofte, in minder dan 8 woorden"

#: assets/js/studio-builder-sketch.js:129
msgid "One or two sentences that back it up"
msgstr "Een of twee zinnen die haar onderbouwen"

#: assets/js/studio-builder-sketch.js:130
msgid "The main action"
msgstr "De hoofdactie"

#: assets/js/studio-builder-sketch.js:131
msgid "A strong, real photo"
msgstr "Een sterke, echte foto"

#: assets/js/studio-builder-sketch.js:133
msgid "Features"
msgstr "Functies"

#: assets/js/studio-builder-sketch.js:136
msgid "One line of intro"
msgstr "Eén regel intro"

#: assets/js/studio-builder-sketch.js:137
#: assets/js/studio-builder-sketch.js:138
#: assets/js/studio-builder-sketch.js:139
msgid "Icon, short title, two lines"
msgstr "Icoon, korte titel, twee regels"

#: assets/js/studio-builder-sketch.js:141
#: assets/js/studio-builder.js:6912
msgid "Pricing"
msgstr "Prijzen"

#: assets/js/studio-builder-sketch.js:143
msgid "Simple plans"
