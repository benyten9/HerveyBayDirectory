#. translators: the accepted comparison values.
#: includes/premium/integrations/rankmath.php:830
#, php-format
msgid "comparison must be one of %s."
msgstr "comparison moet een van deze zijn: %s."

#: includes/premium/integrations/rankmath.php:844
msgid "At least one source is required."
msgstr "Er is minstens één source vereist."

#: includes/premium/integrations/rankmath.php:882
msgid "The Rank Math 404 Monitor module is not active, so nothing has been recorded. Switch it on with nibwp/rankmath-settings set_module."
msgstr "De module 404 Monitor van Rank Math is niet actief, dus er is niets vastgelegd. Zet hem aan met nibwp/rankmath-settings set_module."

#: includes/premium/integrations/rankmath.php:965
msgid "Rank Math — Info"
msgstr "Rank Math — Info"

#: includes/premium/integrations/rankmath.php:1046
msgid "Rank Math keeps per-post SEO in rank_math_* post meta, global settings in four rank-math-options-* options, and redirections plus 404s in its own tables."
msgstr "Rank Math bewaart SEO per bericht in rank_math_*-postmeta, globale instellingen in vier rank-math-options-*-opties, en redirects plus 404's in zijn eigen tabellen."

#: includes/premium/integrations/rankmath.php:1056
msgid "Rank Math — Post SEO"
msgstr "Rank Math — SEO per bericht"

#: includes/premium/integrations/rankmath.php:1123
#: includes/premium/integrations/ultimate-member.php:1988
#: includes/premium/integrations/ultimate-member.php:2045
#: includes/premium/integrations/yoast.php:832
msgid "No post with that ID."
msgstr "Geen bericht met dat ID."

#: includes/premium/integrations/rankmath.php:1138
msgid "No SEO fields were supplied, so nothing was written."
msgstr "Er zijn geen SEO-velden meegegeven, dus er is niets geschreven."

#: includes/premium/integrations/rankmath.php:1144
#: includes/premium/integrations/rankmath.php:1283
msgid "Unknown action. Use get or set."
msgstr "Onbekende actie. Gebruik get of set."

#: includes/premium/integrations/rankmath.php:1152
msgid "Rank Math — Bulk SEO"
msgstr "Rank Math — SEO in bulk"

#: includes/premium/integrations/rankmath.php:1292
msgid "A bulk write overwrites the SEO overrides on every match and cannot be undone. Run action=get with the same filters, then re-issue with confirm set to true."
msgstr "Een bulkschrijfactie overschrijft de SEO-overrides van elke overeenkomst en kan niet worden teruggedraaid. Voer action=get uit met dezelfde filters en doe de aanroep daarna opnieuw met confirm op true."

#: includes/premium/integrations/rankmath.php:1298
msgid "Provide a non-empty \"fields\" object for set."
msgstr "Geef een niet-leeg \"fields\"-object op voor set."

#: includes/premium/integrations/rankmath.php:1342
msgid "Rank Math — Settings"
msgstr "Rank Math — Instellingen"

#: includes/premium/integrations/rankmath.php:1415
msgid "Unknown action. Use get, update_global, update_post_type or set_module."
msgstr "Onbekende actie. Gebruik get, update_global, update_post_type of set_module."

#: includes/premium/integrations/rankmath.php:1451
msgid "robots_global must be an array of directives."
msgstr "robots_global moet een array met directieven zijn."

#: includes/premium/integrations/rankmath.php:1484
msgid "twitter_card_type must be summary_card or summary_large_image."
msgstr "twitter_card_type moet summary_card of summary_large_image zijn."

#: includes/premium/integrations/rankmath.php:1496
msgid "No writable global settings were supplied."
msgstr "Er zijn geen beschrijfbare globale instellingen meegegeven."

#: includes/premium/integrations/rankmath.php:1508
msgid "post_type is required for update_post_type."
msgstr "post_type is verplicht voor update_post_type."

#. translators: the unknown post type name.
#: includes/premium/integrations/rankmath.php:1515
#: includes/premium/integrations/rankmath.php:1941
#, php-format
msgid "Unknown post type: %s."
msgstr "Onbekend post type: %s."

#: includes/premium/integrations/rankmath.php:1560
msgid "No writable post-type settings were supplied."
msgstr "Er zijn geen beschrijfbare post type-instellingen meegegeven."

#: includes/premium/integrations/rankmath.php:1572
msgid "module is required for set_module."
msgstr "module is verplicht voor set_module."

#: includes/premium/integrations/rankmath.php:1575
msgid "enabled is required for set_module."
msgstr "enabled is verplicht voor set_module."

#: includes/premium/integrations/rankmath.php:1588
msgid "Rank Math's module helper is not loaded, and switching a module on without it would leave the module active with no database table. Enable it from the Rank Math dashboard."
msgstr "De module-helper van Rank Math is niet geladen, en een module zonder die helper aanzetten zou de module actief laten zonder databasetabel. Zet hem aan via het Rank Math-dashboard."

#: includes/premium/integrations/rankmath.php:1609
msgid "Rank Math — Redirections"
msgstr "Rank Math — Redirects"

#: includes/premium/integrations/rankmath.php:1665
msgid "Unknown action. Use list, get, create, update, set_status or delete."
msgstr "Onbekende actie. Gebruik list, get, create, update, set_status of delete."

#: includes/premium/integrations/rankmath.php:1671
msgid "Deleting a redirection is permanent. Use set_status with trashed for the reversible option, or re-issue with confirm set to true."
msgstr "Een redirect verwijderen is permanent. Gebruik set_status met trashed voor de omkeerbare optie, of doe de aanroep opnieuw met confirm op true."

#: includes/premium/integrations/rankmath.php:1676
msgid "A valid redirection ID is required."
msgstr "Een geldig redirect-ID is vereist."

#: includes/premium/integrations/rankmath.php:1710
msgid "Rank Math's redirection classes are not loaded, so a rule cannot be written safely — a redirection is a rule plus a lookup cache, and only Rank Math's own save path keeps the two together. Switch the redirections module on with nibwp/rankmath-settings set_module."
msgstr "De redirect-klassen van Rank Math zijn niet geladen, dus een regel kan niet veilig worden geschreven — een redirect is een regel plus een opzoekcache, en alleen de eigen opslagroute van Rank Math houdt die twee bij elkaar. Zet de module Redirections aan met nibwp/rankmath-settings set_module."

#: includes/premium/integrations/rankmath.php:1727
msgid "status must be active, inactive or trashed."
msgstr "status moet active, inactive of trashed zijn."

#: includes/premium/integrations/rankmath.php:1734
#: includes/premium/integrations/rankmath.php:1786
msgid "Rank Math's redirection data layer is unavailable."
msgstr "De datalaag voor redirects van Rank Math is niet beschikbaar."

#. translators: the accepted HTTP codes.
#: includes/premium/integrations/rankmath.php:1748
#, php-format
msgid "header_code must be one of %s."
msgstr "header_code moet een van deze zijn: %s."

#: includes/premium/integrations/rankmath.php:1761
msgid "url_to is required for 301, 302 and 307. Only 410 and 451 have no destination."
msgstr "url_to is verplicht voor 301, 302 en 307. Alleen 410 en 451 hebben geen bestemming."

#: includes/premium/integrations/rankmath.php:1791
msgid "Rank Math refused the rule. Every source pattern has to survive its own sanitisation — an empty pattern, or an invalid regex, is dropped and a rule with no sources is not saved."
msgstr "Rank Math weigerde de regel. Elke source-pattern moet zijn eigen sanitisatie doorstaan — een lege pattern of een ongeldige regex wordt weggegooid, en een regel zonder sources wordt niet opgeslagen."

#: includes/premium/integrations/rankmath.php:1804
#: includes/premium/integrations/rankmath.php:1822
msgid "No redirection with that ID."
msgstr "Geen redirect met dat ID."

#: includes/premium/integrations/rankmath.php:1813
msgid "The Rank Math Redirections module is not active, so there is no redirections table to read."
msgstr "De module Redirections van Rank Math is niet actief, dus er is geen redirects-tabel om te lezen."

#: includes/premium/integrations/rankmath.php:1833
msgid "Rank Math — Sitemap"
msgstr "Rank Math — Sitemap"

#: includes/premium/integrations/rankmath.php:1886
msgid "Unknown action. Use status, update, get_exclusions or set_exclusions."
msgstr "Onbekende actie. Gebruik status, update, get_exclusions of set_exclusions."

#: includes/premium/integrations/rankmath.php:1932
msgid "post_types must be an object of post type => boolean."
msgstr "post_types moet een object zijn van post type => boolean."

#: includes/premium/integrations/rankmath.php:1953
msgid "taxonomies must be an object of taxonomy => boolean."
msgstr "taxonomies moet een object zijn van taxonomie => boolean."

#: includes/premium/integrations/rankmath.php:1973
msgid "No writable sitemap settings were supplied."
msgstr "Er zijn geen beschrijfbare sitemapinstellingen meegegeven."

#: includes/premium/integrations/rankmath.php:1985
msgid "mode must be replace, add or remove."
msgstr "mode moet replace, add of remove zijn."

#: includes/premium/integrations/rankmath.php:1988
msgid "Provide exclude_posts, exclude_terms, or both."
msgstr "Geef exclude_posts, exclude_terms, of beide op."

#. translators: the field name.
#: includes/premium/integrations/rankmath.php:2001
#, php-format
msgid "%s must be an array of IDs."
msgstr "%s moet een array met ID's zijn."

#: includes/premium/integrations/rankmath.php:2027
msgid "Rank Math — Audit"
msgstr "Rank Math — Audit"

#: includes/premium/integrations/rankmath.php:2197
msgid "No meta description, and this post type has no description template either, so Google writes the snippet itself from whatever it finds on the page."
msgstr "Geen metabeschrijving, en dit post type heeft ook geen beschrijvingstemplate, dus Google schrijft de snippet zelf op basis van wat het op de pagina vindt."

#. translators: the post type's Rank Math description template.
#: includes/premium/integrations/rankmath.php:2200
#, php-format
msgid "No meta description of its own. The post type template \"%s\" fills the gap, which is better than nothing but is the same sentence on every post."
msgstr "Geen eigen metabeschrijving. Het post type-template \"%s\" vult het gat, wat beter is dan niets maar op elk bericht dezelfde zin is."

#: includes/premium/integrations/rankmath.php:2203
msgid "Write one with nibwp/rankmath-post set, or fix the whole set at once with nibwp/rankmath-bulk using the missing_description filter."
msgstr "Schrijf er een met nibwp/rankmath-post set, of herstel de hele reeks in één keer met nibwp/rankmath-bulk via het filter missing_description."

#. translators: 1: the title length, 2: the limit.
#: includes/premium/integrations/rankmath.php:2214
#, php-format
msgid "The SEO title is %1$d characters. Rank Math cuts a title off at %2$d in its own preview, and so does Google in the results."
msgstr "De SEO-titel is %1$d tekens. Rank Math kapt een titel in zijn eigen voorbeeld af bij %2$d, en Google doet dat ook in de resultaten."

#. translators: the length limit.
#: includes/premium/integrations/rankmath.php:2220
#, php-format
msgid "Shorten the title to %d characters or fewer with nibwp/rankmath-post set. Put the keyword at the front so it survives the cut."
msgstr "Kort de titel in tot %d tekens of minder met nibwp/rankmath-post set. Zet het zoekwoord vooraan, zodat het de afkapping overleeft."

#. translators: 1: the description length, 2: the limit.
#: includes/premium/integrations/rankmath.php:2233
#, php-format
msgid "The meta description is %1$d characters. Rank Math cuts a description off at %2$d in its own preview."
msgstr "De metabeschrijving is %1$d tekens. Rank Math kapt een beschrijving in zijn eigen voorbeeld af bij %2$d."

#. translators: the length limit.
#: includes/premium/integrations/rankmath.php:2239
#, php-format
msgid "Trim it to %d characters or fewer with nibwp/rankmath-post set."
msgstr "Kort hem in tot %d tekens of minder met nibwp/rankmath-post set."

#: includes/premium/integrations/rankmath.php:2250
msgid "No focus keyword, so Rank Math scores nothing for this post and its content analysis has no target to measure against."
msgstr "Geen focuszoekwoord, dus Rank Math geeft dit bericht geen score en zijn contentanalyse heeft geen doel om tegen te meten."

#: includes/premium/integrations/rankmath.php:2251
msgid "Set focus_keywords with nibwp/rankmath-post set — the first one is the primary keyword."
msgstr "Stel focus_keywords in met nibwp/rankmath-post set — de eerste is het primaire zoekwoord."

#: includes/premium/integrations/rankmath.php:2261
msgid "Navigation menus could not be read on this request, so the noindexed-in-menu check was skipped."
msgstr "De navigatiemenu's konden bij deze aanvraag niet worden gelezen, dus de controle op noindex in menu's is overgeslagen."

#: includes/premium/integrations/rankmath.php:2284
msgid "This page is in a navigation menu and is set to noindex. The site is pointing visitors at it and telling search engines to forget it, which is almost always a noindex nobody lifted after launch."
msgstr "Deze pagina staat in een navigatiemenu en staat op noindex. De site wijst bezoekers ernaartoe en vertelt zoekmachines hem te vergeten, wat bijna altijd een noindex is die na de lancering niemand heeft weggehaald."

#: includes/premium/integrations/rankmath.php:2285
msgid "Remove noindex from the page with nibwp/rankmath-post set robots, or take the item out of the menu if the page really is meant to be private."
msgstr "Haal noindex van de pagina met nibwp/rankmath-post set robots, of haal het item uit het menu als de pagina echt privé bedoeld is."

#: includes/premium/integrations/rankmath.php:2322
msgid "This redirection sends a URL to itself, so the URL never resolves — the browser gives up with a redirect-loop error and search engines drop the page."
msgstr "Deze redirect stuurt een URL naar zichzelf, dus de URL komt nooit uit — de browser geeft op met een redirect-loop-fout en zoekmachines laten de pagina vallen."

#: includes/premium/integrations/rankmath.php:2323
msgid "Point url_to at the real destination with nibwp/rankmath-redirections update, or delete the rule if the page still exists at its own address."
msgstr "Laat url_to naar de echte bestemming wijzen met nibwp/rankmath-redirections update, of verwijder de regel als de pagina nog op zijn eigen adres bestaat."

#: includes/premium/integrations/rankmath.php:2352
msgid "These redirections point at each other, so the URL never resolves — the browser gives up with a redirect-loop error and search engines drop the page."
msgstr "Deze redirects wijzen naar elkaar, dus de URL komt nooit uit — de browser geeft op met een redirect-loop-fout en zoekmachines laten de pagina vallen."

#: includes/premium/integrations/rankmath.php:2353
msgid "Break the cycle with nibwp/rankmath-redirections update: one of these rules has to point at a URL that is not itself redirected."
msgstr "Verbreek de cyclus met nibwp/rankmath-redirections update: een van deze regels moet naar een URL wijzen die zelf niet wordt geredirect."

#. translators: the number of extra hops.
#: includes/premium/integrations/rankmath.php:2365
#, php-format
msgid "This redirection points at a URL that is itself redirected, %d more time(s). Every hop costs a round trip and a little of the link authority that was meant to arrive."
msgstr "Deze redirect wijst naar een URL die zelf ook wordt geredirect, nog %d keer. Elke hop kost een round trip en een beetje van de linkautoriteit die had moeten aankomen."

#: includes/premium/integrations/rankmath.php:2368
msgid "Point this rule straight at the final destination with nibwp/rankmath-redirections update, and leave the later rules in place for anyone still linking to the middle URLs."
msgstr "Laat deze regel rechtstreeks naar de eindbestemming wijzen met nibwp/rankmath-redirections update, en laat de latere regels staan voor wie nog naar de tussenliggende URL's linkt."

#: includes/premium/integrations/rankmath.php:2378
msgid "The Rank Math 404 Monitor module is off, so nothing has been recorded and no 404 can be reported. Switch it on with nibwp/rankmath-settings set_module to find the URLs people are actually reaching for."
msgstr "De module 404 Monitor van Rank Math staat uit, dus er is niets vastgelegd en er kan geen 404 worden gemeld. Zet hem aan met nibwp/rankmath-settings set_module om de URL's te vinden waar mensen echt naar zoeken."

#. translators: the number of hits.
#: includes/premium/integrations/rankmath.php:2397
#, php-format
msgid "This URL has 404ed %d times and no redirection covers it. Each of those was a visitor or a crawler following a link that goes nowhere."
msgstr "Deze URL gaf %d keer een 404 en geen enkele redirect dekt hem. Elke keer was dat een bezoeker of een crawler die een link volgde die nergens naartoe gaat."

#: includes/premium/integrations/rankmath.php:2400
msgid "Create a 301 to the page that replaced it with nibwp/rankmath-redirections create, or answer 410 if the content is genuinely gone and should stop being crawled."
msgstr "Maak een 301 naar de pagina die hem vervangt met nibwp/rankmath-redirections create, of antwoord met 410 als de content echt weg is en niet meer gecrawld hoeft te worden."

#: includes/premium/integrations/rankmath.php:2409
msgid "The Rank Math Redirections module is off, so no redirect loops or chains could be checked."
msgstr "De module Redirections van Rank Math staat uit, dus redirect-loops en -ketens konden niet worden gecontroleerd."

#: includes/premium/integrations/yoast.php:129
msgid "Yoast SEO is not active on this site."
msgstr "Yoast SEO is niet actief op deze site."

#: includes/premium/integrations/yoast.php:593
#: includes/premium/integrations/yoast.php:1484
msgid "index must be one of default, index, noindex."
msgstr "index moet default, index of noindex zijn."

#: includes/premium/integrations/yoast.php:643
msgid "Open Graph output is switched off in Yoast's social settings, so these values are stored but not rendered."
msgstr "Open Graph-uitvoer is uitgeschakeld in de social-instellingen van Yoast, dus deze waarden worden opgeslagen maar niet weergegeven."

#: includes/premium/integrations/yoast.php:646
msgid "X/Twitter card output is switched off in Yoast's social settings, so these values are stored but not rendered."
msgstr "X/Twitter-carduitvoer is uitgeschakeld in de social-instellingen van Yoast, dus deze waarden worden opgeslagen maar niet weergegeven."

#: includes/premium/integrations/yoast.php:670
msgid "Yoast SEO — Info"
msgstr "Yoast SEO — Info"

#: includes/premium/integrations/yoast.php:753
msgid "Yoast keeps a derived copy of every object in its own indexable table. This integration writes post meta and options only and lets Yoast rebuild the index from them."
msgstr "Yoast bewaart van elk object een afgeleide kopie in zijn eigen indexable-tabel. Deze integratie schrijft alleen postmeta en opties en laat Yoast de index daaruit opnieuw opbouwen."

#: includes/premium/integrations/yoast.php:761
msgid "Yoast SEO — Post SEO"
msgstr "Yoast SEO — SEO per bericht"

#: includes/premium/integrations/yoast.php:826
#: includes/premium/integrations/yoast.php:1007
#: includes/premium/integrations/yoast.php:1432
msgid "action must be get or set."
msgstr "action moet get of set zijn."

#: includes/premium/integrations/yoast.php:859
msgid "Yoast SEO — Bulk"
msgstr "Yoast SEO — Bulk"

#: includes/premium/integrations/yoast.php:1015
msgid "Provide a non-empty \"fields\" object saying what to write."
msgstr "Geef een niet-leeg \"fields\"-object op dat zegt wat er geschreven moet worden."

#: includes/premium/integrations/yoast.php:1022
msgid "A bulk write changes many posts at once. Re-issue with dry_run=true to preview it, or confirm=true to commit it."
msgstr "Een bulkschrijfactie wijzigt veel berichten in één keer. Doe de aanroep opnieuw met dry_run=true voor een voorbeeld, of met confirm=true om hem vast te leggen."

#: includes/premium/integrations/yoast.php:1029
#: includes/premium/integrations/yoast.php:1859
msgid "WP_Query is unavailable."
msgstr "WP_Query is niet beschikbaar."

#: includes/premium/integrations/yoast.php:1080
msgid "Yoast SEO — Title & meta templates"
msgstr "Yoast SEO — Titel- en metatemplates"

#: includes/premium/integrations/yoast.php:1253
msgid "action must be get, get_raw or set."
msgstr "action moet get, get_raw of set zijn."

#: includes/premium/integrations/yoast.php:1259
msgid "A template change rewrites the titles of every page of that type. Re-issue with confirm=true."
msgstr "Een templatewijziging herschrijft de titels van elke pagina van dat type. Doe de aanroep opnieuw met confirm=true."

#: includes/premium/integrations/yoast.php:1280
msgid "Nothing to write. Give a post_type or taxonomy with the template fields, or a settings object of wpseo_titles keys."
msgstr "Niets om te schrijven. Geef een post_type of taxonomy mee met de templatevelden, of een settings-object met wpseo_titles-sleutels."

#: includes/premium/integrations/yoast.php:1287
msgid "WPSEO_Options::set() is unavailable, and NIBWP will not write Yoast's option rows directly — its validation is what keeps a template from breaking every title. Change these in Yoast > Settings."
msgstr "WPSEO_Options::set() is niet beschikbaar, en NIBWP schrijft de optierijen van Yoast niet direct — juist zijn validatie voorkomt dat een template elke titel sloopt. Wijzig deze in Yoast > Settings."

#: includes/premium/integrations/yoast.php:1318
msgid "Yoast did not store these keys. Usually the post type or taxonomy name does not exist on this site, or its own validation rejected the value."
msgstr "Yoast heeft deze sleutels niet opgeslagen. Meestal bestaat de naam van het post type of de taxonomie niet op deze site, of heeft zijn eigen validatie de waarde afgewezen."

#: includes/premium/integrations/yoast.php:1326
msgid "Yoast SEO — Term SEO"
msgstr "Yoast SEO — SEO per term"

#: includes/premium/integrations/yoast.php:1427
msgid "A valid term_id and taxonomy are required."
msgstr "Een geldige term_id en taxonomy zijn vereist."

#: includes/premium/integrations/yoast.php:1438
msgid "No term with that ID in that taxonomy."
msgstr "Geen term met dat ID in die taxonomie."

#: includes/premium/integrations/yoast.php:1496
msgid "Nothing to write. Give at least one field."
msgstr "Niets om te schrijven. Geef minstens één veld op."

#: includes/premium/integrations/yoast.php:1502
msgid "WPSEO_Taxonomy_Meta::set_values() is unavailable, and NIBWP will not rewrite the wpseo_taxonomy_meta option directly — its validation decides which fields survive. Edit the term in Yoast instead."
msgstr "WPSEO_Taxonomy_Meta::set_values() is niet beschikbaar, en NIBWP herschrijft de optie wpseo_taxonomy_meta niet direct — zijn validatie bepaalt welke velden overblijven. Bewerk de term in plaats daarvan in Yoast."

#: includes/premium/integrations/yoast.php:1521
msgid "Yoast SEO — Redirects (Premium)"
msgstr "Yoast SEO — Redirects (Premium)"

#: includes/premium/integrations/yoast.php:1596
msgid "action must be list, create or delete."
msgstr "action moet list, create of delete zijn."

#: includes/premium/integrations/yoast.php:1602
msgid "Redirects are a Yoast SEO Premium feature and Premium is not active on this site. Use the NIBWP Redirection integration, or add the rule at server level."
msgstr "Redirects zijn een functie van Yoast SEO Premium en Premium is niet actief op deze site. Gebruik de NIBWP-integratie voor Redirection, of voeg de regel op serverniveau toe."

#: includes/premium/integrations/yoast.php:1610
msgid "A redirect changes where a live URL sends visitors. Re-issue with confirm=true."
msgstr "Een redirect wijzigt waar een live URL bezoekers naartoe stuurt. Doe de aanroep opnieuw met confirm=true."

#: includes/premium/integrations/yoast.php:1618
msgid "Yoast Premium is active but its WPSEO_Redirect_Option class was not found, so NIBWP cannot reach the redirect store. Manage redirects in Yoast > Redirects."
msgstr "Yoast Premium is actief maar zijn klasse WPSEO_Redirect_Option is niet gevonden, dus NIBWP kan de redirect-opslag niet bereiken. Beheer redirects in Yoast > Redirects."

#: includes/premium/integrations/yoast.php:1642
msgid "No redirects were returned. On a site that has some, this means Yoast Premium's redirect reader is not shaped as expected — check Yoast > Redirects."
msgstr "Er zijn geen redirects teruggekomen. Op een site die er wel heeft, betekent dat dat de redirect-lezer van Yoast Premium niet de verwachte vorm heeft — kijk in Yoast > Redirects."

#: includes/premium/integrations/yoast.php:1649
msgid "origin is required."
msgstr "origin is verplicht."

#: includes/premium/integrations/yoast.php:1656
msgid "Yoast Premium's redirect deletion API was not found. Remove the redirect in Yoast > Redirects."
msgstr "De API van Yoast Premium om redirects te verwijderen is niet gevonden. Verwijder de redirect in Yoast > Redirects."

#: includes/premium/integrations/yoast.php:1672
msgid "type must be one of 301, 302, 307, 410, 451."
msgstr "type moet een van deze zijn: 301, 302, 307, 410, 451."

#: includes/premium/integrations/yoast.php:1677
msgid "target is required for a 301, 302 or 307."
msgstr "target is verplicht voor een 301, 302 of 307."

#: includes/premium/integrations/yoast.php:1683
msgid "Yoast Premium's redirect creation API was not found, so NIBWP will not write its redirect store by hand. Add the redirect in Yoast > Redirects."
msgstr "De API van Yoast Premium om redirects aan te maken is niet gevonden, dus NIBWP schrijft de redirect-opslag niet met de hand. Voeg de redirect toe in Yoast > Redirects."

#: includes/premium/integrations/yoast.php:1717
msgid "Yoast SEO — Audit"
msgstr "Yoast SEO — Audit"

#: includes/premium/integrations/yoast.php:1932
msgid "This is marked as cornerstone content and set to noindex, so the page you told Yoast matters most is the one you have asked search engines to ignore."
msgstr "Dit is gemarkeerd als cornerstone-content en staat op noindex, dus de pagina waarvan je Yoast vertelde dat hij het belangrijkst is, is precies de pagina die je zoekmachines vraagt te negeren."

#: includes/premium/integrations/yoast.php:1933
msgid "Call nibwp/yoast-post with action=set, index=default to hand the page back to its post type setting, or index=index to force it in. If the page really should stay hidden, clear the cornerstone flag with cornerstone=false instead."
msgstr "Roep nibwp/yoast-post aan met action=set, index=default om de pagina terug te geven aan de instelling van zijn post type, of index=index om hem er toch in te dwingen. Als de pagina echt verborgen moet blijven, haal dan in plaats daarvan de cornerstone-markering weg met cornerstone=false."

#. translators: 1: canonical URL, 2: comma-separated post IDs.
#: includes/premium/integrations/yoast.php:1950
#, php-format
msgid "Its canonical URL is %1$s, which %2$s also claims. Search engines will keep only one of them, and the losers stay linked and in the sitemap while being absent from results."
msgstr "De canonical URL is %1$s, en %2$s claimt die ook. Zoekmachines houden er maar één van over, en de verliezers blijven gelinkt en in de sitemap staan terwijl ze afwezig zijn in de resultaten."

#: includes/premium/integrations/yoast.php:1954
msgid "Decide which URL is the real one. On every other post call nibwp/yoast-post with action=set and canonical set to an empty string, which clears the override and lets Yoast use the post's own URL."
msgstr "Bepaal welke URL de echte is. Roep op elk ander bericht nibwp/yoast-post aan met action=set en canonical op een lege string, wat de override wist en Yoast de eigen URL van het bericht laat gebruiken."

#: includes/premium/integrations/yoast.php:1969
msgid "No meta description, and the post type has no description template to fall back on, so the search result snippet is whatever Google decides to quote from the page."
msgstr "Geen metabeschrijving, en het post type heeft geen beschrijvingstemplate om op terug te vallen, dus de snippet in de zoekresultaten is wat Google besluit van de pagina te citeren."

#: includes/premium/integrations/yoast.php:1970
msgid "Write one with nibwp/yoast-post action=set, metadesc=\"…\", or set a template for the whole post type with nibwp/yoast-templates action=set, post_type=…, metadesc=\"…\". To fill a backlog in one pass use nibwp/yoast-bulk with missing=metadesc."
msgstr "Schrijf er een met nibwp/yoast-post action=set, metadesc=\"…\", of stel een template in voor het hele post type met nibwp/yoast-templates action=set, post_type=…, metadesc=\"…\". Gebruik nibwp/yoast-bulk met missing=metadesc om een achterstand in één keer weg te werken."

#. translators: 1: actual length, 2: Yoast's limit.
#: includes/premium/integrations/yoast.php:1984
#, php-format
msgid "The meta description is %1$d characters against Yoast's own limit of %2$d, so the end of it will be cut off in search results."
msgstr "De metabeschrijving is %1$d tekens tegen de eigen limiet van Yoast van %2$d, dus het einde wordt in de zoekresultaten afgekapt."

#. translators: %d: Yoast's meta description limit.
#: includes/premium/integrations/yoast.php:1990
#, php-format
msgid "Shorten it to %d characters or fewer with nibwp/yoast-post action=set, metadesc=\"…\", putting what matters first."
msgstr "Kort hem in tot %d tekens of minder met nibwp/yoast-post action=set, metadesc=\"…\", en zet vooraan wat belangrijk is."

#. translators: 1: title length, 2: the threshold used.
#: includes/premium/integrations/yoast.php:2017
#, php-format
msgid "The SEO title is %1$d characters, past the %2$d-character mark where search results usually truncate. Yoast measures this in pixels, which cannot be reproduced here, so treat it as an approximation and check the editor's own bar."
msgstr "De SEO-titel is %1$d tekens, voorbij de grens van %2$d tekens waar zoekresultaten meestal afkappen. Yoast meet dit in pixels, wat hier niet te reproduceren is, dus beschouw het als een benadering en controleer de balk in de editor zelf."

#: includes/premium/integrations/yoast.php:2021
msgid "Shorten it with nibwp/yoast-post action=set, title=\"…\". Moving the site name into the template with nibwp/yoast-templates usually buys back the most room."
msgstr "Kort hem in met nibwp/yoast-post action=set, title=\"…\". De sitenaam naar het template verplaatsen met nibwp/yoast-templates levert meestal de meeste ruimte op."

#: includes/premium/integrations/yoast.php:2032
msgid "No focus keyphrase, so Yoast's keyphrase analysis has nothing to measure this page against and its SEO score means nothing."
msgstr "Geen focuszoekwoord, dus de zoekwoordanalyse van Yoast heeft niets om deze pagina tegen te meten en zijn SEO-score betekent niets."

#: includes/premium/integrations/yoast.php:2033
msgid "Set one with nibwp/yoast-post action=set, focuskw=\"…\". nibwp/yoast-bulk with missing=focuskw lists every post in the same state."
msgstr "Stel er een in met nibwp/yoast-post action=set, focuskw=\"…\". nibwp/yoast-bulk met missing=focuskw geeft elk bericht in dezelfde staat weer."

#: includes/premium/integrations/yoast.php:2042
msgid "Yoast's keyphrase analysis is switched off on this site, so a missing focus keyphrase is not a fault here."
msgstr "De zoekwoordanalyse van Yoast is uitgeschakeld op deze site, dus een ontbrekend focuszoekwoord is hier geen fout."

#: includes/premium/integrations/yoast.php:2063
msgid "Yoast's indexable table was not found, and incoming links cannot be counted without it."
msgstr "De indexable-tabel van Yoast is niet gevonden, en zonder die tabel kunnen inkomende links niet worden geteld."

#: includes/premium/integrations/yoast.php:2072
msgid "Nothing on the site links to this page. Search engines reach it only through the sitemap, and visitors reading anything else will never find it."
msgstr "Niets op de site linkt naar deze pagina. Zoekmachines bereiken hem alleen via de sitemap, en bezoekers die iets anders lezen, vinden hem nooit."

#: includes/premium/integrations/yoast.php:2073
msgid "Link to it from a related published page. If it should not be found at all, set it to noindex with nibwp/yoast-post action=set, index=noindex so it stops diluting the rest of the site."
msgstr "Link ernaartoe vanaf een gerelateerde gepubliceerde pagina. Als hij helemaal niet gevonden moet worden, zet hem dan op noindex met nibwp/yoast-post action=set, index=noindex, zodat hij de rest van de site niet langer verdunt."

#: includes/premium/integrations/yoast.php:2057
msgid "Yoast's text link counter is switched off, so the incoming-link count this check reads stays at zero and every post would look orphaned."
msgstr "De tekstlinkteller van Yoast is uitgeschakeld, dus het aantal inkomende links waaruit dit gelezen zou worden, wordt nooit gevuld. Met die teller uit zou elk bericht als verweesd gelezen worden."

#. translators: %d: how many further actions the integration offers
#: includes/integrations-page.php:2979
#, php-format
msgid "+%d more"
msgstr "+%d meer"

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:149
msgid "Change prices across a filtered set of products by percentage or fixed amount"
msgstr "Prijzen over een gefilterde set producten aanpassen met een percentage of een vast bedrag"

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:167
msgid "Configure a brand-new store end to end — address, currency, where you sell, where you ship"
msgstr "Een compleet nieuwe winkel van begin tot eind inrichten – adres, valuta, waar je verkoopt, waar je verzendt"

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:231
msgid "Cross-sells, upsells, grouped children and external product links"
msgstr "Cross-sells, upsells, gegroepeerde onderdelen en links naar externe producten"

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:253
msgid "Downloadable files, download limits and expiry"
msgstr "Downloadbare bestanden, downloadlimieten en vervaltermijnen"

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:261
msgid "Duplicate a product, variations and all"
msgstr "Een product dupliceren, varianten en al"

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:295
msgid "Export products, orders or customers to CSV and get the download URL"
msgstr "Producten, bestellingen of klanten exporteren naar CSV en de download-URL krijgen"

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:329
msgid "Generate every variation of a variable product in one call instead of clicking a grid"
msgstr "Elke variant van een variabel product in één aanroep genereren in plaats van een raster aan te klikken"

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:337
msgid "Global product attributes and their terms — the prerequisite for real variable products"
msgstr "Globale productattributen en hun termen – de voorwaarde voor echte variabele producten"

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:349
msgid "Import a product CSV with a dry run first that names every bad row"
msgstr "Een product-CSV importeren, met eerst een proefrun die elke foute regel benoemt"

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:481
msgid "Product images pulled straight from a URL into the media library"
msgstr "Productafbeeldingen rechtstreeks van een URL naar de mediabibliotheek halen"

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:483
msgid "Product tags, created and tidied in bulk"
msgstr "Producttags, in bulk aangemaakt en opgeruimd"

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:573
msgid "Resume a large import in batches instead of one request that times out"
msgstr "Een grote import in batches hervatten in plaats van in één verzoek dat verloopt"

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:605
msgid "Schedule a sale for a date range and clear it again afterwards"
msgstr "Een aanbieding voor een periode inplannen en daarna weer opheffen"

#. translators: Skill tagline: woocommerce-pro
#: includes/i18n-data-strings.php:617
msgid "Set up and run the whole store — taxes, shipping zones, payment gateways, webhooks, global attributes, variations, and bulk CSV import/export"
msgstr "De hele winkel inrichten en beheren – btw, verzendzones, betaalmethoden, webhooks, globale attributen, varianten en CSV-import en -export in bulk"

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:621
msgid "Shipping zones with flat rate, free shipping and local pickup, priced per zone"
msgstr "Verzendzones met vast tarief, gratis verzending en ophalen, per zone geprijsd"

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:653
msgid "Tax classes and tax rates by country, state, postcode and city, with priorities and compound rates"
msgstr "Btw-klassen en btw-tarieven per land, provincie, postcode en plaats, met prioriteiten en samengestelde tarieven"

#. translators: Skill description: woocommerce-pro
#: includes/i18n-data-strings.php:657
msgid "The Free WooCommerce abilities cover the catalogue and the order book. This skill covers the store around them: general settings and selling locations, tax classes and tax rates, shipping zones and the methods inside them, payment gateways, webhooks, global product attributes and their terms, generating every variation of a variable product, cross-sells and upsells, downloadable files, product images from a URL, tags, bulk price changes, scheduled sales, product duplication, and bulk CSV import and export with a dry run that reports every bad row before anything is written."
msgstr "De gratis WooCommerce-mogelijkheden dekken de catalogus en de bestellingen. Deze skill dekt de winkel daarom heen: algemene instellingen en verkooplocaties, btw-klassen en btw-tarieven, verzendzones en de methoden daarin, betaalmethoden, webhooks, globale productattributen en hun termen, het genereren van elke variant van een variabel product, cross-sells en upsells, downloadbare bestanden, productafbeeldingen van een URL, tags, prijswijzigingen in bulk, ingeplande aanbiedingen, het dupliceren van producten en CSV-import en -export in bulk met een proefrun die elke foute regel meldt voordat er iets wordt geschreven."

#. translators: Skill feature: woocommerce-pro
#: includes/i18n-data-strings.php:681
