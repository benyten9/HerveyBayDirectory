#: includes/integrations/paper/paper-page.php:821
msgid "Copy prompt for your agent"
msgstr "Prompt voor je agent kopiëren"

#: includes/integrations/figma/figma.php:1110
#: includes/integrations/paper/paper-page.php:838
msgid "Create a draft"
msgstr "Een concept aanmaken"

