#: assets/js/studio-builder-sketch.js:88
msgid "e.g. Our 30-second tour teaser"
msgstr "par ex. Notre teaser de 30 secondes sur le circuit"

#: assets/js/studio-builder-sketch.js:89
#: assets/js/studio-builder.js:213
#: assets/js/studio-builder.js:300
#: assets/js/studio-builder.js:2749
#: assets/js/studio-builder.js:3189
msgid "Icon"
msgstr "Icône"

#: assets/js/studio-builder-sketch.js:89
msgid "e.g. A check mark"
msgstr "par ex. Une coche"

#: assets/js/studio-builder-sketch.js:90
#: assets/js/studio-builder.js:210
msgid "Space"
msgstr "Espace"

#: assets/js/studio-builder-sketch.js:90
msgid "Breathing room"
msgstr "De l’air"

#: assets/js/studio-builder-sketch.js:125
#: assets/js/studio-builder.js:234
msgid "Hero"
msgstr "Héro"

#: assets/js/studio-builder-sketch.js:126
msgid "The first thing visitors see"
msgstr "La première chose que voient les visiteurs"

#: assets/js/studio-builder-sketch.js:128
msgid "The promise, in under 8 words"
msgstr "La promesse, en moins de 8 mots"

#: assets/js/studio-builder-sketch.js:129
