{
    "name": "doublescale/doublescale",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "DoubleScale"
        }
    ],
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "squizlabs/php_codesniffer": "^3.10",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "wp-coding-standards/wpcs": "^3.1",
        "sirbrillig/phpcs-variable-analysis": "^2.11",
        "phpunit/phpunit": "^9.6",
        "spatie/phpunit-watcher": "^1.23",
        "yoast/phpunit-polyfills": "^1.0"
    },
    "require": {
        "composer/installers": "~1.0"
    },
    "autoload": {
        "psr-4": {
            "DoubleScale\\": "includes/"
        },
        "classmap": [
            "includes/Modules/Smtp/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DoubleScale\\Tests\\": "phpunit/tests/",
            "DoubleScale\\Tests\\Integration\\": "tests/integration/"
        }
    },
    "config": {
        "process-timeout": 0,
        "platform": {
            "php": "7.4"
        },
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "autoloader-suffix": "DoubleScale"
    },
    "scripts": {
        "post-install-cmd": [
            "cd dependencies && composer install"
        ],
        "post-update-cmd": [
            "cd dependencies && composer update"
        ],
        "scope:vendor": [
            "test -f php-scoper.phar || curl -LSs https://github.com/humbug/php-scoper/releases/download/0.17.7/php-scoper.phar -o php-scoper.phar",
            "test -f dependencies/vendor/autoload.php || (echo 'ERROR: Run cd dependencies && composer install before scope:vendor' >&2 && exit 1)",
            "@php php-scoper.phar add-prefix --config=dependencies/scoper.inc.php --force --output-dir=dependencies/build",
            "@php tools/fix-scoper-output.php",
            "cd dependencies && composer dump-autoload --working-dir=build --classmap-authoritative --no-scripts"
        ],
        "format": "phpcbf --standard=phpcs.xml.dist --report-summary --report-source",
        "lint": "phpcs --standard=phpcs.xml.dist",
        "test": "phpunit --bootstrap phpunit/bootstrap.php --testsuite fast",
        "test:smoke": "phpunit --bootstrap phpunit/bootstrap.php --testsuite fast --group smoke",
        "test:integration": "phpunit --bootstrap tests/integration/bootstrap.php --testsuite integration",
        "test:integration:maybe": "php bin/run-integration-tests.php",
        "test:all": [
            "@test",
            "@test:integration:maybe"
        ],
        "test:all:with-integration": [
            "@test",
            "@test:integration"
        ],
        "test:e2e": "npm run e2e",
        "test:e2e:smoke": "npm run e2e:smoke",
        "test:watch": "phpunit-watcher watch < /dev/tty"
    }
}